---
import BlogLayout from "../../layouts/BlogLayout.astro";
import SystemSidebar from "../../components/system/SystemSidebar.astro";
import PhotoCard from "../../components/PhotoCard.astro";
import PhotoLightbox from "../../components/PhotoLightbox.astro";
import { getCollection } from "astro:content";

const photos = await getCollection("photos", ({ data }) => !data.draft);

const byRoll = new Map<string, typeof photos>();
for (const photo of photos) {
  const roll = photo.data.roll ?? "sem rolo";
  if (!byRoll.has(roll)) byRoll.set(roll, []);
  byRoll.get(roll)!.push(photo);
}

const MONTHS = [
  "jan",
  "fev",
  "mar",
  "abr",
  "mai",
  "jun",
  "jul",
  "ago",
  "set",
  "out",
  "nov",
  "dez",
];

const time = (date?: Date) => (date ? date.getTime() : 0);
const monthYear = (date: Date) =>
  `${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()}`;

const slugify = (value: string) => {
  const slug = value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
  return slug || "sem-rolo";
};

type Roll = {
  roll: string;
  slug: string;
  list: typeof photos;
  range: string;
  latest: number;
  start: number;
};

const usedSlugs = new Set<string>();
const rolls: Roll[] = [...byRoll.entries()].map(([roll, list]) => {
  list.sort((a, b) => time(b.data.date) - time(a.data.date));

  const dates = list
    .map((photo) => photo.data.date)
    .filter((date): date is Date => Boolean(date))
    .sort((a, b) => a.getTime() - b.getTime());

  const first = dates[0];
  const last = dates[dates.length - 1];
  const range =
    first && last
      ? monthYear(first) === monthYear(last)
        ? monthYear(first)
        : `${monthYear(first)} – ${monthYear(last)}`
      : "";

  let slug = slugify(roll);
  let suffix = 2;
  while (usedSlugs.has(slug)) slug = `${slugify(roll)}-${suffix++}`;
  usedSlugs.add(slug);

  return {
    roll,
    slug,
    list,
    range,
    latest: last ? last.getTime() : 0,
    start: 0,
  };
});

rolls.sort((a, b) => b.latest - a.latest);

let cursor = 0;
for (const roll of rolls) {
  roll.start = cursor;
  cursor += roll.list.length;
}
---

<BlogLayout
  title="Photos"
  bodyClass="photos-page"
  section="photos"
  code="OPT_03"
  pageTitle="photos"
  pageDescription="fotos da Canon, organizadas por rolo. uma folha de contato por rolo — clica num quadro pra abrir, e usa as setas do teclado pra navegar."
  meta={[
    { label: "fotos", value: String(photos.length) },
    { label: "rolos", value: String(rolls.length) },
  ]}
  wide={true}
>
  <SystemSidebar
    slot="sidebar"
    indexTitle="rolos"
    indexClass="sys-roll-index"
    items={rolls.map(({ roll, slug, list }) => ({
      label: roll,
      href: `#${slug}`,
      count: list.length,
    }))}
    meta={[
      { label: "fotos", value: String(photos.length) },
      { label: "rolos", value: String(rolls.length) },
      { label: "modo", value: "contato" },
    ]}
    note="clica num quadro pra abrir o viewer. setas ← → navegam, Esc fecha."
  />

  {
    rolls.length === 0 ? (
      <p class="empty">nenhuma foto por aqui ainda.</p>
    ) : (
      <>
        {rolls.map(({ roll, slug, list, range, start }) => (
          <section class="roll" id={slug} aria-labelledby={`${slug}-title`}>
            <header class="roll-head">
              <h2 id={`${slug}-title`}>{roll}</h2>
              <span class="roll-count">
                {list.length} foto{list.length !== 1 ? "s" : ""}
              </span>
              {range && <span class="roll-range">{range}</span>}
            </header>

            <ol class="contact-sheet">
              {list.map((photo, i) => (
                <PhotoCard
                  photo={photo}
                  index={start + i + 1}
                  frame={i + 1}
                  total={photos.length}
                  roll={roll}
                />
              ))}
            </ol>
          </section>
        ))}

        <PhotoLightbox />
      </>
    )
  }
</BlogLayout>

<script>
  const sections = Array.from(document.querySelectorAll<HTMLElement>(".roll"));
  const links = new Map(
    Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".sys-roll-index a"),
    ).map((link) => [link.hash.slice(1), link]),
  );

  if (sections.length && links.size) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => link.classList.remove("is-current"));
          links.get(entry.target.id)?.classList.add("is-current");
        }
      },
      { rootMargin: "-20% 0px -65% 0px", threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
