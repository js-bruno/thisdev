---
import BlogLayout from "../../layouts/BlogLayout.astro";
import PhotoCard from "../../components/PhotoCard.astro";
import { getCollection } from "astro:content";

const photos = await getCollection("photos", ({ data }) => !data.draft);

const byRoll = new Map<string, typeof photos>();
for (const photo of photos) {
  const roll = photo.data.roll ?? "sem rolo";
  if (!byRoll.has(roll)) byRoll.set(roll, []);
  byRoll.get(roll)!.push(photo);
}

for (const list of byRoll.values()) {
  list.sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });
}

const rolls = [...byRoll.entries()];
---

<BlogLayout title="Photos" background>
  <h1>photos</h1>
  <p>
    fotos da Canon, organizadas por rolo. passa o mouse por cima e usa a roda
    pra rolar pro lado, ou arrasta. tudo passa pelo dithering.
  </p>

  {
    rolls.length === 0 ? (
      <p class="empty">nenhuma foto por aqui ainda.</p>
    ) : (
      rolls.map(([roll, list]) => (
        <section class="roll">
          <div class="roll-head">
            <h2>{roll}</h2>
            <span class="roll-count">
              {list.length} foto{list.length !== 1 ? "s" : ""}
            </span>
          </div>
          <div
            class="roll-track"
            tabindex="0"
            role="region"
            aria-label={`${roll}, ${list.length} fotos`}
          >
            {list.map((photo) => (
              <PhotoCard
                src={photo.data.src}
                alt={photo.data.alt}
                title={photo.data.title}
                camera={photo.data.camera}
                lens={photo.data.lens}
                location={photo.data.location}
              />
            ))}
          </div>
        </section>
      ))
    )
  }
</BlogLayout>

<script>
  function enableWheelScroll(track: HTMLElement) {
    track.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        const max = track.scrollWidth - track.clientWidth;
        if (max <= 0) return;

        const atStart = track.scrollLeft <= 0 && event.deltaY < 0;
        const atEnd = track.scrollLeft >= max - 1 && event.deltaY > 0;
        if (atStart || atEnd) return;

        event.preventDefault();
        track.scrollLeft += event.deltaY;
      },
      { passive: false },
    );
  }

  document
    .querySelectorAll<HTMLElement>(".roll-track")
    .forEach(enableWheelScroll);
</script>
