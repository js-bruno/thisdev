---
import BlogLayout from "../layouts/BlogLayout.astro";
import AboutMicroblog from "../components/AboutMicroblog.tsx";

const facts = [
  { label: "name", value: "jos'e" },
  { label: "age", value: "25" },
  { label: "pronouns", value: "he/him" },
  { label: "language", value: "pt-br, eng" },
  { label: "tempo de dev", value: "5 anos" },
  { label: "sistema", value: "2 anos de NixOS" },
];
---

<BlogLayout
  title="About"
  section="about"
  code="ID_07"
  pageTitle="some of me"
  pageDescription="ficha de identificação de quem escreve este arquivo. sem currículo, sem roadmap — só o que sobrou depois do dither, e o que ainda não virou post."
  meta={[
    { label: "status", value: "online" },
    { label: "modo", value: "dark only" },
  ]}
>

  <section class="about-grid" aria-label="ficha pessoal">
    <div class="sys-panel about-file" id="identidade">
      <div class="sys-panel-head">
        <span>ident // registro</span>
        <span aria-hidden="true">⌁</span>
      </div>

      <ul class="about-list">
        {
          facts.map((fact) => (
            <li>
              <span class="about-label">{fact.label}</span>
              <span>
                {fact.label === "tempo de dev" ? (
                  <span class="about-dev">5 anos trampando como dev</span>
                ) : fact.label === "sistema" ? (
                  <span class="about-nix">2 anos usando NixOS</span>
                ) : (
                  fact.value
                )}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="about-quote">
        não sei exatamente o que estou fazendo, mas estou fazendo algo.
      </p>
    </div>

    <figure class="sys-panel about-portrait" id="retrato">
      <div class="sys-panel-head">
        <span>img_001 // self</span>
        <span aria-hidden="true">◐</span>
      </div>
      <img
        src="/assets/images/me1.png"
        alt="eu"
        loading="lazy"
        decoding="async"
      />
      <figcaption>retrato recuperado do arquivo local</figcaption>
    </figure>
  </section>

  <section class="sys-panel about-diary" id="diario" aria-labelledby="diario-title">
    <div class="sys-panel-head">
      <span id="diario-title">diário // íntimo</span>
      <span aria-hidden="true">✎</span>
    </div>
    <AboutMicroblog client:load />
  </section>

  <p class="about-foot" id="nota">all rights reserved to all of us.</p>
</BlogLayout>
