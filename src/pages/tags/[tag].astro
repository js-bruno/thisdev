---
import BlogLayout from "../../layouts/BlogLayout.astro";
import SystemSidebar from "../../components/system/SystemSidebar.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  const tagMap = new Map<string, typeof posts>();

  posts.forEach((post) => {
    const tags = post.data.tags;
    if (!tags) return;
    const arr = Array.isArray(tags) ? tags : [tags];
    arr.forEach((tag) => {
      const slug = tag.toLowerCase().replace(/\s+/g, "-");
      if (!tagMap.has(slug)) tagMap.set(slug, []);
      tagMap.get(slug)!.push(post);
    });
  });

  return [...tagMap.entries()].map(([slug, tagPosts]) => ({
    params: { tag: slug },
    props: { tag: slug, tagPosts, allPosts: posts },
  }));
}

const { tag, tagPosts, allPosts } = Astro.props;

const sorted = [...tagPosts].sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const counts = new Map<string, number>();

allPosts.forEach((post) => {
  const tags = post.data.tags;
  if (!tags) return;
  const list = Array.isArray(tags) ? tags : [tags];
  list.forEach((item) => {
    const slug = item.toLowerCase().replace(/\s+/g, "-");
    counts.set(slug, (counts.get(slug) ?? 0) + 1);
  });
});

const allTags = [...counts.entries()]
  .map(([slug, count]) => ({ slug, count }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

<BlogLayout
  title={`Tag: ${tag}`}
  section="tags"
  code={`TAG_${tag.toUpperCase()}`}
  pageTitle={`tag // ${tag}`}
  pageDescription={`transmissões marcadas com #${tag}. ${sorted.length} registro${sorted.length === 1 ? "" : "s"} encontrado${sorted.length === 1 ? "" : "s"}.`}
  meta={[
    { label: "registros", value: String(sorted.length) },
  ]}
>
  <SystemSidebar
    slot="sidebar"
    indexTitle="todas as tags"
    items={allTags.map((item) => ({
      label: `#${item.slug}`,
      href: `/tags/${item.slug}/`,
      count: item.count,
      current: item.slug === tag,
    }))}
    meta={[
      { label: "tag", value: `#${tag}` },
      { label: "registros", value: String(sorted.length) },
      { label: "modo", value: "dark only" },
    ]}
    note={`voltar para o índice de tags: /tags/`}
  />

  <ol reversed class="tag-log">
    {
      sorted.map((post) => {
        const date = post.data.date ? new Date(post.data.date) : null;
        const htmlDate = date ? date.toISOString().split("T")[0] : null;
        const readableDate = date
          ? date.toLocaleDateString("pt-BR", {
              day: "2-digit",
              month: "short",
              year: "numeric",
              timeZone: "UTC",
            })
          : null;

        return (
          <li>
            <a href={`/ai-slops/${post.slug}/`}>{post.data.title}</a>
            {htmlDate && readableDate && (
              <time datetime={htmlDate}>{readableDate}</time>
            )}
          </li>
        );
      })
    }
  </ol>

  <p class="res-rail-note">
    <a href="/tags/">← todos os assuntos</a>
  </p>
</BlogLayout>
