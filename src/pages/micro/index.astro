---
import BlogLayout from "../../layouts/BlogLayout.astro";
import MicroEntry from "../../components/MicroEntry.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("micro", ({ data }) => !data.draft);
const sorted = entries.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const rendered = await Promise.all(
  sorted.map(async (entry) => ({
    entry,
    Content: (await entry.render()).Content,
  })),
);
---

<BlogLayout title="Micro" background>
  <h1>micro</h1>
  <p>
    coisas aleatórias que eu quero jogar na web sem virar post. um caderno de
    recados, mais ou menos.
  </p>

  {
    rendered.length === 0 ? (
      <p class="empty">nada por aqui ainda.</p>
    ) : (
      <ul class="feed">
        {rendered.map(({ entry, Content }) => (
          <MicroEntry
            date={entry.data.date}
            mood={entry.data.mood}
            tags={entry.data.tags}
            image={entry.data.image}
          >
            <Content />
          </MicroEntry>
        ))}
      </ul>
    )
  }
</BlogLayout>
