---
import BlogLayout from "../layouts/BlogLayout.astro";

const bottoms = [
  { src: "/assets/images/bottoms/coils.webp", alt: "coils.net", href: "https://coils.net" },
  { src: "/assets/images/bottoms/dimdens.webp", alt: "dimdens.net", href: "https://dimdens.net" },
  { src: "/assets/images/bottoms/oii.webp", alt: "oii", href: "https://oii.io" },
  { src: "/assets/images/bottoms/inkcaps.webp", alt: "inkcaps", href: "https://inkcaps.net" },
  { src: "/assets/images/bottoms/vms.webp", alt: "vms", href: "https://vms.net" },
  { src: "/assets/images/bottoms/ribozone.webp", alt: "ribozone", href: "https://ribo.zone" },
];
---

<BlogLayout
  title="Links"
  section="links"
  code="NET_05"
  pageTitle="links"
  pageDescription="sites de pessoas que eu acho massa e quero guardar por perto. botões 88×31, como manda o protocolo."
  meta={[
    { label: "nós", value: String(bottoms.length) },
    { label: "protocolo", value: "88×31" },
  ]}
>

  <section class="sys-panel" id="vizinhos">
    <div class="sys-panel-head">
      <span>neighbors // {bottoms.length}</span>
      <span aria-hidden="true">↗</span>
    </div>
    <div class="links-wall">
      {
        bottoms.map((b) => (
          <a href={b.href} title={b.alt} target="_blank" rel="noopener">
            <img src={b.src} alt={b.alt} loading="lazy" decoding="async" />
          </a>
        ))
      }
    </div>
  </section>

  <section class="sys-panel" id="link-me">
    <div class="sys-panel-head">
      <span>link me</span>
      <span aria-hidden="true">⌁</span>
    </div>
    <p class="links-note">
      se quiser apontar pra cá, fica à vontade. copia o bloco e cola no teu
      site.
    </p>
    <pre class="linkme-code"><code>{`<a href="https://thisdev.space"><img src="SEU_BOTAO_AQUI" alt="this dev"></a>`}</code></pre>
  </section>
</BlogLayout>
