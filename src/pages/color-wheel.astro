---
import BlogLayout from "../layouts/BlogLayout.astro";
---

<BlogLayout title="Color Wheel" description="círculo cromático pra brincar com matizes, harmonia e paletas de cor." bodyClass="wheel-page">
  <style>
    :global(body.wheel-page) {
      --col: 76rem;
    }

    h1 {
      margin-bottom: 0.4rem;
    }

    .wheel-intro {
      max-width: 46rem;
      color: var(--muted);
    }

    .wheel-grid {
      display: grid;
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      gap: 1.4rem;
      align-items: start;
      margin: 2rem 0 1.4rem;
    }

    .wheel-grid .card h2,
    .wheel-bottom .card h2,
    .codes-card h2,
    .series-card h2 {
      margin: 0;
      font-size: 1em;
      letter-spacing: 0.02em;
    }

    .wheel-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.1rem;
      padding: 1.4rem;
    }

    .wheel-wrap {
      position: relative;
      width: min(100%, 340px);
      aspect-ratio: 1;
      touch-action: none;
      cursor: crosshair;
      border-radius: 50%;
    }

    .wheel-wrap:focus-visible {
      outline: 2px dotted var(--accent);
      outline-offset: 7px;
    }

    #wheel {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
      box-shadow:
        0 0 0 4px var(--bg-deep),
        0 0 0 5px var(--border);
    }

    .markers {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    :global(.marker) {
      position: absolute;
      width: var(--size, 14px);
      height: var(--size, 14px);
      border: 2px solid #fff;
      border-radius: 50%;
      background: var(--marker);
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.85),
        0 0 5px rgb(0 0 0 / 0.45);
      transform: translate(-50%, -50%);
      pointer-events: auto;
      cursor: grab;
      transition:
        width 0.15s ease,
        height 0.15s ease,
        background-color 0.15s ease,
        border-color 0.15s ease;
    }

    :global(.marker:active) {
      cursor: grabbing;
    }

    :global(.marker.is-base) {
      --size: 18px;
      z-index: 3;
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.9),
        0 0 0 3px var(--marker),
        0 0 8px rgb(0 0 0 / 0.5);
    }

    :global(.marker.is-base)::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5);
      transform: translate(-50%, -50%);
    }

    :global(.marker.is-mono) {
      border-color: var(--marker);
      background: transparent;
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.7),
        inset 0 0 0 1px rgb(255 255 255 / 0.3);
      pointer-events: none;
    }

    :global(.marker.is-mono.is-base) {
      border-width: 3px;
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.85),
        0 0 0 2px rgb(255 255 255 / 0.55),
        inset 0 0 0 1px rgb(255 255 255 / 0.3);
    }

    :global(.marker.is-mono.is-base)::after {
      content: none;
    }

    .ring-knob {
      position: absolute;
      width: 16px;
      height: 16px;
      border: 2px solid #fff;
      border-radius: 50%;
      background: var(--knob);
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.85),
        0 0 5px rgb(0 0 0 / 0.45);
      transform: translate(-50%, -50%);
      pointer-events: auto;
      cursor: ns-resize;
      z-index: 4;
    }

    .readout {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      border-top: 1px dotted var(--border-strong);
      padding-top: 0.9rem;
    }

    .value-copy {
      display: flex;
      align-items: baseline;
      gap: 0.65rem;
      width: 100%;
      padding: 2px 4px;
      border: 0;
      border-bottom: 1px dotted transparent;
      background: transparent;
      color: var(--ink);
      font-family: var(--mono);
      text-align: left;
      cursor: pointer;
    }

    .value-copy:hover,
    .value-copy:focus-visible {
      background: var(--surface);
      border-bottom-color: var(--border-strong);
      color: var(--accent-2);
    }

    .value-copy .tag {
      flex: 0 0 2.6rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--faint);
      font-size: 0.62em;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #hexOut {
      font-size: 1.35em;
      letter-spacing: 0.06em;
    }

    #rgbOut,
    #hslOut {
      font-size: 0.78em;
      color: var(--muted);
    }

    .block {
      display: inline-block;
      width: 0.85em;
      height: 0.85em;
      margin-right: 0.45em;
      border: 1px solid var(--border-strong);
      vertical-align: baseline;
    }

    .copy-status {
      min-height: 1.2em;
      margin: 0;
      font-size: 0.68em;
      letter-spacing: 0.08em;
      color: var(--accent-2);
      text-transform: uppercase;
    }

    .controls {
      padding: 1.4rem;
    }

    .control {
      margin: 0 0 1.1rem;
    }

    .control:last-of-type {
      margin-bottom: 0;
    }

    .control-label {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.25rem;
      font-size: 0.72em;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .control-label output {
      color: var(--ink);
      letter-spacing: 0.03em;
    }

    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      display: block;
      width: 100%;
      height: 20px;
      margin: 0;
      background: transparent;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-runnable-track {
      height: 8px;
      background: var(--track, var(--border));
      border: 1px solid var(--border-strong);
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 13px;
      height: 20px;
      margin-top: -7px;
      border: 1px solid var(--border-strong);
      border-radius: 0;
      background: var(--ink);
    }

    input[type="range"]::-moz-range-track {
      height: 8px;
      background: var(--track, var(--border));
      border: 1px solid var(--border-strong);
    }

    input[type="range"]::-moz-range-thumb {
      width: 13px;
      height: 20px;
      border: 1px solid var(--border-strong);
      border-radius: 0;
      background: var(--ink);
    }

    input[type="range"]:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    .hex-row {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 0.6rem;
      margin: 1.3rem 0 0;
      padding-top: 1.1rem;
      border-top: 1px dotted var(--border-strong);
    }

    .hex-field {
      flex: 1 1 8rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.72em;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .hex-field input {
      width: 100%;
      padding: 3px 6px;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
      color: var(--ink);
      font-family: var(--mono);
      font-size: 1.15em;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .hex-field input:focus-visible {
      outline: 1px dotted var(--accent);
      outline-offset: 1px;
    }

    .hex-field input.invalid {
      border-color: #b3554b;
      color: #e3a19a;
    }

    .btn {
      padding: 4px 10px 5px;
      border: 1px solid var(--border-strong);
      background: var(--surface);
      color: var(--ink);
      font-family: var(--display);
      font-size: 0.68em;
      letter-spacing: 0.06em;
      line-height: 1.4;
      text-transform: uppercase;
      cursor: pointer;
    }

    .btn:hover,
    .btn:focus-visible {
      background: var(--bg-deep);
      color: var(--accent-2);
      border-color: var(--accent);
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn[aria-pressed="true"] {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--bg-deep);
    }

    .btn.tiny {
      padding: 1px 6px 2px;
      font-size: 0.6em;
    }

    .scheme-block {
      margin-top: 1.2rem;
      padding-top: 1.1rem;
      border-top: 1px dotted var(--border-strong);
    }

    .scheme-title {
      margin: 0 0 0.55rem;
      font-size: 0.72em;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .scheme-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .scheme-row .btn {
      font-size: 0.6em;
    }

    .swatches {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.9rem;
    }

    :global(.swatch-card) {
      display: flex;
      flex-direction: column;
      width: 78px;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
    }

    :global(.swatch-main) {
      height: 48px;
      padding: 0;
      border: 0;
      border-bottom: 1px solid var(--border);
      background: var(--swatch);
      cursor: pointer;
    }

    :global(.swatch-main:hover),
    :global(.swatch-main:focus-visible) {
      outline: 2px solid var(--accent-2);
      outline-offset: -2px;
    }

    :global(.swatch-foot) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.1rem;
      padding: 0 0.2rem 0 0.35rem;
      font-family: var(--mono);
      font-size: 0.61em;
      color: var(--muted);
      line-height: 1.7;
    }

    :global(.swatch-add) {
      padding: 0 0.25rem;
      border: 0;
      background: transparent;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 1.05em;
      line-height: 1.5;
      cursor: pointer;
    }

    :global(.swatch-add:hover),
    :global(.swatch-add:focus-visible) {
      background: var(--surface);
      color: var(--accent-2);
    }

    .hint {
      margin: 0.7rem 0 0;
      font-size: 0.7em;
      color: var(--faint);
      font-style: italic;
    }

    .wheel-bottom {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 1.4rem;
      align-items: start;
      margin-bottom: 1.5rem;
    }

    .wheel-bottom .card {
      padding: 1.4rem;
    }

    .panel-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.6rem;
    }

    .panel-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .palette-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.9rem;
    }

    :global(.chip) {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 2px 4px 2px 3px;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
      font-family: var(--mono);
      font-size: 0.64em;
    }

    :global(.chip-color) {
      display: inline-block;
      width: 1.45em;
      height: 1.45em;
      border: 1px solid var(--border);
    }

    :global(.chip button) {
      padding: 0 0.15rem;
      border: 0;
      background: transparent;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 1em;
      line-height: 1.4;
      cursor: pointer;
    }

    :global(.chip button:hover),
    :global(.chip button:focus-visible) {
      color: var(--accent-2);
      background: var(--surface);
    }

    .palette-tools {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem;
      margin-top: 0.9rem;
      padding-top: 0.8rem;
      border-top: 1px dotted var(--border-strong);
    }

    .export-group {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      margin-left: auto;
    }

    .tag-mini {
      font-size: 0.6em;
      letter-spacing: 0.1em;
      color: var(--faint);
      text-transform: uppercase;
    }

    .import-block {
      margin-top: 0.9rem;
      font-size: 0.72em;
    }

    .import-block summary {
      cursor: pointer;
      color: var(--muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .import-block summary:hover {
      color: var(--accent-2);
    }

    .import-block textarea {
      width: 100%;
      margin-top: 0.5rem;
      padding: 6px;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
      color: var(--ink);
      font-family: var(--mono);
      font-size: 0.95em;
      letter-spacing: 0.04em;
      resize: vertical;
    }

    .preview-shell {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 260px;
      margin-top: 0.9rem;
      padding: 1.1rem;
      border: 1px solid var(--border-strong);
      transition: background-color 0.2s ease;
    }

    .preview-card {
      width: 100%;
      padding: 1.15rem 1.2rem;
      border: 1px solid;
    }

    .preview-kicker {
      display: block;
      font-family: var(--mono);
      font-size: 0.62em;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0.8;
    }

    .preview-title {
      margin: 0.3rem 0 0.45rem;
      font-family: var(--display);
      font-size: 1.35em;
      font-weight: 700;
      line-height: 1.2;
    }

    .preview-text {
      margin: 0 0 0.95rem;
      font-family: var(--mono);
      font-size: 0.72em;
      line-height: 1.65;
      opacity: 0.9;
    }

    .preview-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.8rem;
    }

    .preview-btn {
      padding: 4px 11px 5px;
      border: 1px solid;
      font-family: var(--display);
      font-size: 0.66em;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .preview-link {
      font-family: var(--mono);
      font-size: 0.68em;
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 3px;
    }

    .codes-card {
      margin-bottom: 1.4rem;
      padding: 1.4rem;
    }

    .codes-table {
      display: table;
      width: 100%;
      margin-top: 0.9rem;
      border-collapse: collapse;
      font-family: var(--mono);
      font-size: 0.72em;
      table-layout: fixed;
      overflow: visible;
    }

    .codes-table th {
      padding: 0 0 0.35rem;
      border: 0;
      border-bottom: 1px dotted var(--border-strong);
      background: transparent;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 0.85em;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-align: left;
      text-transform: uppercase;
    }

    .codes-table th:first-child {
      width: 5.4rem;
    }

    .codes-table th:nth-child(3) {
      width: 46%;
    }

    :global(.codes-table td) {
      padding: 0.18rem 0;
      border: 0;
      border-bottom: 1px dotted var(--border);
      vertical-align: middle;
    }

    :global(.codes-table td:first-child) {
      color: var(--faint);
      font-size: 0.9em;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    :global(.code-cell) {
      width: 100%;
      padding: 2px 5px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--ink);
      font-family: var(--mono);
      font-size: 1em;
      letter-spacing: 0.02em;
      text-align: left;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      cursor: pointer;
    }

    :global(.code-cell:hover),
    :global(.code-cell:focus-visible) {
      border-color: var(--border-strong);
      background: var(--surface);
      color: var(--accent-2);
    }

    :global(.code-cell.code-empty) {
      color: var(--faint);
      cursor: default;
    }

    :global(.code-cell.code-empty:hover) {
      border-color: transparent;
      background: transparent;
      color: var(--faint);
    }

    .series-card {
      margin-bottom: 1.4rem;
      padding: 1.4rem;
    }

    .series {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: 0.9rem;
    }

    :global(.series-row) {
      display: grid;
      grid-template-columns: 4.2rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.6rem;
    }

    :global(.series-label) {
      margin: 0;
      font-size: 0.68em;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-transform: uppercase;
    }

    :global(.series-strip) {
      display: flex;
      min-width: 0;
      border: 1px solid var(--border-strong);
    }

    :global(.series-swatch) {
      flex: 1 1 0;
      min-width: 0;
      height: 34px;
      padding: 0;
      border: 0;
      border-right: 1px solid rgb(0 0 0 / 0.25);
      background: var(--swatch);
      cursor: pointer;
    }

    :global(.series-swatch:last-child) {
      border-right: 0;
    }

    :global(.series-swatch:hover),
    :global(.series-swatch:focus-visible) {
      outline: 2px solid var(--accent-2);
      outline-offset: -2px;
    }

    :global(.series-actions) {
      display: flex;
      gap: 0.25rem;
    }

    .theory {
      max-width: 46rem;
      margin: 0 0 2rem;
    }

    .theory h2 {
      margin-bottom: 0.6rem;
      color: var(--muted);
      font-size: 0.8em;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .theory details {
      border-top: 1px dotted var(--border-strong);
      padding: 0.6rem 0;
    }

    .theory summary {
      font-family: var(--display);
      font-size: 1em;
      cursor: pointer;
    }

    .theory summary:hover {
      color: var(--accent-2);
    }

    .theory details p {
      margin: 0.55rem 0 0;
      color: var(--muted);
      font-size: 0.8em;
      line-height: 1.7;
    }

    @media (max-width: 800px) {
      .wheel-grid,
      .wheel-bottom {
        grid-template-columns: minmax(0, 1fr);
      }

      .wheel-panel {
        padding: 1rem;
      }

      :global(.series-row) {
        grid-template-columns: minmax(0, 1fr) auto;
      }

      :global(.series-label) {
        grid-column: 1 / -1;
      }

      .codes-table {
        font-size: 0.68em;
        table-layout: auto;
      }

      .codes-table th:first-child {
        width: 4.2rem;
      }

      .codes-table th:nth-child(3) {
        width: 44%;
      }

      :global(.code-cell) {
        white-space: normal;
        overflow-wrap: anywhere;
        text-overflow: clip;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .preview-shell {
        transition: none;
      }

      :global(.marker) {
        transition: none;
      }
    }
  </style>

  <h1>círculo cromático</h1>
  <p class="wheel-intro">
    escolha um matiz no círculo, ajuste a saturação na distância do centro e a
    luminosidade no anel externo. arraste qualquer círculo pra girar a harmonia
    inteira, ou clique no <strong>+</strong> pra guardar uma cor na paleta.
  </p>

  <section class="wheel-grid">
    <div class="card wheel-panel">
      <div
        class="wheel-wrap"
        id="wheelWrap"
        role="slider"
        tabindex="0"
        aria-label="matiz e saturação pelo círculo cromático, luminosidade pelo anel externo"
        aria-valuemin="0"
        aria-valuemax="359"
        aria-valuenow="172"
        title="arraste pra escolher matiz e saturação · anel externo muda a luminosidade · shift trava o matiz em 15°"
      >
        <canvas id="wheel" width="480" height="480" aria-hidden="true"></canvas>
        <div class="markers" id="markers" aria-hidden="true">
          <span class="ring-knob" id="ringKnob"></span>
        </div>
      </div>

      <div class="readout">
        <button class="value-copy" data-copy="hex" aria-label="copiar valor hex">
          <span class="tag">hex</span>
          <span id="hexOut"><span class="block" id="colorBlock"></span><span id="hexText">#3C9A8E</span></span>
        </button>
        <button class="value-copy" data-copy="rgb" aria-label="copiar valor rgb">
          <span class="tag">rgb</span>
          <span id="rgbOut"></span>
        </button>
        <button class="value-copy" data-copy="hsl" aria-label="copiar valor hsl">
          <span class="tag">hsl</span>
          <span id="hslOut"></span>
        </button>
        <p class="copy-status" id="copyStatus" aria-live="polite"></p>
      </div>
    </div>

    <div class="card controls">
      <div class="control">
        <label class="control-label" for="hue">
          <span>matiz</span>
          <output id="hueOut" for="hue">172°</output>
        </label>
        <input id="hue" type="range" min="0" max="359" step="1" value="172" />
      </div>

      <div class="control">
        <label class="control-label" for="sat">
          <span>saturação</span>
          <output id="satOut" for="sat">44%</output>
        </label>
        <input id="sat" type="range" min="0" max="100" step="1" value="44" />
      </div>

      <div class="control">
