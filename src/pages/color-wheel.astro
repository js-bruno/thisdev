---
import BlogLayout from "../layouts/BlogLayout.astro";
---

<BlogLayout title="Color Wheel" description="círculo cromático pra brincar com matizes, harmonia e paletas de cor." bodyClass="wheel-page">
  <style>
    :global(body.wheel-page) {
      --col: 76rem;
    }

    h1 {
      margin-bottom: 0.4rem;
    }

    .wheel-intro {
      max-width: 46rem;
      color: var(--muted);
    }

    .wheel-grid {
      display: grid;
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      gap: 1.4rem;
      align-items: start;
      margin: 2rem 0 1.4rem;
    }

    .wheel-grid .card h2,
    .wheel-bottom .card h2 {
      margin: 0;
      font-size: 1em;
      letter-spacing: 0.02em;
    }

    .wheel-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.1rem;
      padding: 1.4rem;
    }

    .wheel-wrap {
      position: relative;
      width: min(100%, 340px);
      aspect-ratio: 1;
      touch-action: none;
      cursor: crosshair;
      border-radius: 50%;
    }

    .wheel-wrap:focus-visible {
      outline: 2px dotted var(--accent);
      outline-offset: 7px;
    }

    #wheel {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
      box-shadow:
        0 0 0 4px var(--bg-deep),
        0 0 0 5px var(--border);
    }

    .markers {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    :global(.marker) {
      position: absolute;
      width: var(--size, 14px);
      height: var(--size, 14px);
      border: 2px solid #fff;
      border-radius: 50%;
      background: var(--marker);
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.85),
        0 0 5px rgb(0 0 0 / 0.45);
      transform: translate(-50%, -50%);
      pointer-events: auto;
      cursor: crosshair;
      transition:
        width 0.15s ease,
        height 0.15s ease,
        background-color 0.15s ease,
        border-color 0.15s ease;
    }

    :global(.marker.is-base) {
      --size: 18px;
      z-index: 3;
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.9),
        0 0 0 3px var(--marker),
        0 0 8px rgb(0 0 0 / 0.5);
    }

    :global(.marker.is-base)::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5);
      transform: translate(-50%, -50%);
    }

    :global(.marker.is-mono) {
      border-color: var(--marker);
      background: transparent;
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.7),
        inset 0 0 0 1px rgb(255 255 255 / 0.3);
      pointer-events: none;
    }

    :global(.marker.is-mono.is-base) {
      border-width: 3px;
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.85),
        0 0 0 2px rgb(255 255 255 / 0.55),
        inset 0 0 0 1px rgb(255 255 255 / 0.3);
    }

    :global(.marker.is-mono.is-base)::after {
      content: none;
    }

    .readout {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      border-top: 1px dotted var(--border-strong);
      padding-top: 0.9rem;
    }

    .value-copy {
      display: flex;
      align-items: baseline;
      gap: 0.65rem;
      width: 100%;
      padding: 2px 4px;
      border: 0;
      border-bottom: 1px dotted transparent;
      background: transparent;
      color: var(--ink);
      font-family: var(--mono);
      text-align: left;
      cursor: pointer;
    }

    .value-copy:hover,
    .value-copy:focus-visible {
      background: var(--surface);
      border-bottom-color: var(--border-strong);
      color: var(--accent-2);
    }

    .value-copy .tag {
      flex: 0 0 2.6rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--faint);
      font-size: 0.62em;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #hexOut {
      font-size: 1.35em;
      letter-spacing: 0.06em;
    }

    #rgbOut,
    #hslOut {
      font-size: 0.78em;
      color: var(--muted);
    }

    .block {
      display: inline-block;
      width: 0.85em;
      height: 0.85em;
      margin-right: 0.45em;
      border: 1px solid var(--border-strong);
      vertical-align: baseline;
    }

    .copy-status {
      min-height: 1.2em;
      margin: 0;
      font-size: 0.68em;
      letter-spacing: 0.08em;
      color: var(--accent-2);
      text-transform: uppercase;
    }

    .controls {
      padding: 1.4rem;
    }

    .control {
      margin: 0 0 1.1rem;
    }

    .control:last-of-type {
      margin-bottom: 0;
    }

    .control-label {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.25rem;
      font-size: 0.72em;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .control-label output {
      color: var(--ink);
      letter-spacing: 0.03em;
    }

    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      display: block;
      width: 100%;
      height: 20px;
      margin: 0;
      background: transparent;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-runnable-track {
      height: 8px;
      background: var(--track, var(--border));
      border: 1px solid var(--border-strong);
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 13px;
      height: 20px;
      margin-top: -7px;
      border: 1px solid var(--border-strong);
      border-radius: 0;
      background: var(--ink);
    }

    input[type="range"]::-moz-range-track {
      height: 8px;
      background: var(--track, var(--border));
      border: 1px solid var(--border-strong);
    }

    input[type="range"]::-moz-range-thumb {
      width: 13px;
      height: 20px;
      border: 1px solid var(--border-strong);
      border-radius: 0;
      background: var(--ink);
    }

    input[type="range"]:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    .hex-row {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 0.6rem;
      margin: 1.3rem 0 0;
      padding-top: 1.1rem;
      border-top: 1px dotted var(--border-strong);
    }

    .hex-field {
      flex: 1 1 8rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.72em;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .hex-field input {
      width: 100%;
      padding: 3px 6px;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
      color: var(--ink);
      font-family: var(--mono);
      font-size: 1.15em;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .hex-field input:focus-visible {
      outline: 1px dotted var(--accent);
      outline-offset: 1px;
    }

    .hex-field input.invalid {
      border-color: #b3554b;
      color: #e3a19a;
    }

    .btn {
      padding: 4px 10px 5px;
      border: 1px solid var(--border-strong);
      background: var(--surface);
      color: var(--ink);
      font-family: var(--display);
      font-size: 0.68em;
      letter-spacing: 0.06em;
      line-height: 1.4;
      text-transform: uppercase;
      cursor: pointer;
    }

    .btn:hover,
    .btn:focus-visible {
      background: var(--bg-deep);
      color: var(--accent-2);
      border-color: var(--accent);
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn[aria-pressed="true"] {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--bg-deep);
    }

    .scheme-block {
      margin-top: 1.2rem;
      padding-top: 1.1rem;
      border-top: 1px dotted var(--border-strong);
    }

    .scheme-title {
      margin: 0 0 0.55rem;
      font-size: 0.72em;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .scheme-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .scheme-row .btn {
      font-size: 0.6em;
    }

    .swatches {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.9rem;
    }

    :global(.swatch-card) {
      display: flex;
      flex-direction: column;
      width: 78px;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
    }

    :global(.swatch-main) {
      height: 48px;
      padding: 0;
      border: 0;
      border-bottom: 1px solid var(--border);
      background: var(--swatch);
      cursor: pointer;
    }

    :global(.swatch-main:hover),
    :global(.swatch-main:focus-visible) {
      outline: 2px solid var(--accent-2);
      outline-offset: -2px;
    }

    :global(.swatch-foot) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.1rem;
      padding: 0 0.2rem 0 0.35rem;
      font-family: var(--mono);
      font-size: 0.61em;
      color: var(--muted);
      line-height: 1.7;
    }

    :global(.swatch-add) {
      padding: 0 0.25rem;
      border: 0;
      background: transparent;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 1.05em;
      line-height: 1.5;
      cursor: pointer;
    }

    :global(.swatch-add:hover),
    :global(.swatch-add:focus-visible) {
      background: var(--surface);
      color: var(--accent-2);
    }

    .hint {
      margin: 0.7rem 0 0;
      font-size: 0.7em;
      color: var(--faint);
      font-style: italic;
    }

    .wheel-bottom {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 1.4rem;
      align-items: start;
      margin-bottom: 1.5rem;
    }

    .wheel-bottom .card {
      padding: 1.4rem;
    }

    .panel-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.6rem;
    }

    .panel-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .palette-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.9rem;
    }

    :global(.chip) {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 2px 4px 2px 3px;
      border: 1px solid var(--border-strong);
      background: var(--bg-deep);
      font-family: var(--mono);
      font-size: 0.64em;
    }

    :global(.chip-color) {
      display: inline-block;
      width: 1.45em;
      height: 1.45em;
      border: 1px solid var(--border);
    }

    :global(.chip button) {
      padding: 0 0.15rem;
      border: 0;
      background: transparent;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 1em;
      line-height: 1.4;
      cursor: pointer;
    }

    :global(.chip button:hover),
    :global(.chip button:focus-visible) {
      color: var(--accent-2);
      background: var(--surface);
    }

    .preview-shell {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 260px;
      margin-top: 0.9rem;
      padding: 1.1rem;
      border: 1px solid var(--border-strong);
      transition: background-color 0.2s ease;
    }

    .preview-card {
      width: 100%;
      padding: 1.15rem 1.2rem;
      border: 1px solid;
    }

    .preview-kicker {
      display: block;
      font-family: var(--mono);
      font-size: 0.62em;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0.8;
    }

    .preview-title {
      margin: 0.3rem 0 0.45rem;
      font-family: var(--display);
      font-size: 1.35em;
      font-weight: 700;
      line-height: 1.2;
    }

    .preview-text {
      margin: 0 0 0.95rem;
      font-family: var(--mono);
      font-size: 0.72em;
      line-height: 1.65;
      opacity: 0.9;
    }

    .preview-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.8rem;
    }

    .preview-btn {
      padding: 4px 11px 5px;
      border: 1px solid;
      font-family: var(--display);
      font-size: 0.66em;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .preview-link {
      font-family: var(--mono);
      font-size: 0.68em;
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 3px;
    }

    @media (max-width: 800px) {
      .wheel-grid,
      .wheel-bottom {
        grid-template-columns: minmax(0, 1fr);
      }

      .wheel-panel {
        padding: 1rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .preview-shell {
        transition: none;
      }
    }
  </style>

  <h1>círculo cromático</h1>
  <p class="wheel-intro">
    escolha um matiz no círculo, ajuste saturação e luminosidade, e teste harmonias
    até achar uma paleta que preste. clique nas cores pra usar como base, ou no
    <strong>+</strong> pra guardar na sua paleta.
  </p>

  <section class="wheel-grid">
    <div class="card wheel-panel">
      <div
        class="wheel-wrap"
        id="wheelWrap"
        role="slider"
        tabindex="0"
        aria-label="matiz e saturação pelo círculo cromático"
        aria-valuemin="0"
        aria-valuemax="359"
        aria-valuenow="172"
      >
        <canvas id="wheel" width="480" height="480" aria-hidden="true"></canvas>
        <div class="markers" id="markers" aria-hidden="true"></div>
      </div>

      <div class="readout">
        <button class="value-copy" data-copy="hex" aria-label="copiar valor hex">
          <span class="tag">hex</span>
          <span id="hexOut"><span class="block" id="colorBlock"></span><span id="hexText">#3FA7A0</span></span>
        </button>
        <button class="value-copy" data-copy="rgb" aria-label="copiar valor rgb">
          <span class="tag">rgb</span>
          <span id="rgbOut"></span>
        </button>
        <button class="value-copy" data-copy="hsl" aria-label="copiar valor hsl">
          <span class="tag">hsl</span>
          <span id="hslOut"></span>
        </button>
        <p class="copy-status" id="copyStatus" aria-live="polite"></p>
      </div>
    </div>

    <div class="card controls">
      <div class="control">
        <label class="control-label" for="hue">
          <span>matiz</span>
          <output id="hueOut" for="hue">172°</output>
        </label>
        <input id="hue" type="range" min="0" max="359" step="1" value="172" />
      </div>

      <div class="control">
        <label class="control-label" for="sat">
          <span>saturação</span>
          <output id="satOut" for="sat">44%</output>
        </label>
        <input id="sat" type="range" min="0" max="100" step="1" value="44" />
      </div>

      <div class="control">
        <label class="control-label" for="light">
          <span>luminosidade</span>
          <output id="lightOut" for="light">42%</output>
        </label>
        <input id="light" type="range" min="0" max="100" step="1" value="42" />
      </div>

      <div class="hex-row">
        <label class="hex-field" for="hexInput">
          hex
          <input id="hexInput" type="text" value="#3FA7A0" autocomplete="off" spellcheck="false" maxlength="7" />
        </label>
        <button class="btn" id="randomBtn" type="button">aleatória</button>
      </div>

      <div class="scheme-block">
        <p class="scheme-title" id="schemeLabel">harmonia</p>
        <div class="scheme-row" id="schemeBtns" role="group" aria-labelledby="schemeLabel">
          <button class="btn" type="button" data-scheme="complementar" aria-pressed="false">complementar</button>
          <button class="btn" type="button" data-scheme="analogica" aria-pressed="true">análoga</button>
          <button class="btn" type="button" data-scheme="triade" aria-pressed="false">tríade</button>
          <button class="btn" type="button" data-scheme="tetrade" aria-pressed="false">tétrade</button>
          <button class="btn" type="button" data-scheme="monocromatica" aria-pressed="false">mono</button>
        </div>
        <div class="swatches" id="swatches" aria-label="cores da harmonia"></div>
        <p class="hint">clique na cor pra usar como base · + guarda na paleta</p>
      </div>
    </div>
  </section>

  <section class="wheel-bottom">
    <div class="card">
      <div class="panel-head">
        <h2>minha paleta</h2>
        <div class="panel-actions">
          <button class="btn" id="copyCssBtn" type="button">copiar css</button>
          <button class="btn" id="clearPaletteBtn" type="button">limpar</button>
        </div>
      </div>
      <p class="hint" id="paletteHint">suas cores ficam salvas no navegador.</p>
      <p class="empty" id="paletteEmpty">vazia por enquanto. usa o + nas amostras acima.</p>
      <div class="palette-list" id="paletteList" aria-label="minha paleta"></div>
      <p class="copy-status" id="paletteStatus" aria-live="polite"></p>
    </div>

    <div class="card">
      <div class="panel-head">
        <h2>teste da paleta</h2>
        <span class="hint" id="previewSource">prévia com a harmonia atual</span>
      </div>
      <div class="preview-shell" id="previewShell">
        <div class="preview-card" id="previewCard">
          <span class="preview-kicker" id="previewKicker">are you dreaming?</span>
          <p class="preview-title" id="previewTitle">um título qualquer</p>
          <p class="preview-text" id="previewText">
            texto de exemplo pra sentir o contraste, o peso e o clima da paleta
            antes de usar de verdade.
          </p>
          <div class="preview-actions">
            <span class="preview-btn" id="previewBtn">botão</span>
            <span class="preview-link" id="previewLink">um link</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const STORAGE_KEY = "thisdev-color-palette";
    const CANVAS_SIZE = 480;
    const schemes = {
      complementar: [0, 180],
      analogica: [-25, 0, 25],
      triade: [0, 120, 240],
      tetrade: [0, 90, 180, 270],
      monocromatica: "mono",
    };

    const state = {
      h: 172,
      s: 44,
      l: 42,
      scheme: "analogica",
      palette: [],
    };

    const wrap = document.getElementById("wheelWrap");
    const canvas = document.getElementById("wheel");
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    const markers = document.getElementById("markers");
    const colorBlock = document.getElementById("colorBlock");
    const hexText = document.getElementById("hexText");
    const rgbOut = document.getElementById("rgbOut");
    const hslOut = document.getElementById("hslOut");
    const hexInput = document.getElementById("hexInput");
    const hue = document.getElementById("hue");
    const sat = document.getElementById("sat");
    const light = document.getElementById("light");
    const hueOut = document.getElementById("hueOut");
    const satOut = document.getElementById("satOut");
    const lightOut = document.getElementById("lightOut");
    const copyStatus = document.getElementById("copyStatus");
    const paletteStatus = document.getElementById("paletteStatus");
    const paletteList = document.getElementById("paletteList");
    const paletteEmpty = document.getElementById("paletteEmpty");
    const previewShell = document.getElementById("previewShell");
    const previewCard = document.getElementById("previewCard");
    const previewBtn = document.getElementById("previewBtn");
    const previewLink = document.getElementById("previewLink");
    const previewSource = document.getElementById("previewSource");
    const schemeBtns = [...document.querySelectorAll("[data-scheme]")];
    const swatches = document.getElementById("swatches");

    function clamp(n, min, max) {
      return Math.min(max, Math.max(min, n));
    }

    function hslToRgb(h, s, l) {
      h = ((h % 360) + 360) % 360;
      s = clamp(s, 0, 100) / 100;
      l = clamp(l, 0, 100) / 100;
      const c = (1 - Math.abs(2 * l - 1)) * s;
      const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
      const m = l - c / 2;
      let r = 0;
      let g = 0;
      let b = 0;
      if (h < 60) [r, g, b] = [c, x, 0];
      else if (h < 120) [r, g, b] = [x, c, 0];
      else if (h < 180) [r, g, b] = [0, c, x];
      else if (h < 240) [r, g, b] = [0, x, c];
      else if (h < 300) [r, g, b] = [x, 0, c];
      else [r, g, b] = [c, 0, x];
      return [
        Math.round((r + m) * 255),
        Math.round((g + m) * 255),
        Math.round((b + m) * 255),
      ];
    }

    function toHex(n) {
      return n.toString(16).padStart(2, "0");
    }

    function hslToHex(h, s, l) {
      const [r, g, b] = hslToRgb(h, s, l);
      return "#" + toHex(r) + toHex(g) + toHex(b);
    }

    function hexToHsl(hex) {
      let clean = hex.trim().replace(/^#/, "");
      if (clean.length === 3) {
        clean = clean
          .split("")
          .map((c) => c + c)
          .join("");
      }
      if (!/^[0-9a-f]{6}$/i.test(clean)) return null;
      const r = parseInt(clean.slice(0, 2), 16) / 255;
      const g = parseInt(clean.slice(2, 4), 16) / 255;
      const b = parseInt(clean.slice(4, 6), 16) / 255;
      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      const l = (max + min) / 2;
      let h = 0;
      let s = 0;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        if (max === r) h = ((g - b) / d) % 6;
        else if (max === g) h = (b - r) / d + 2;
        else h = (r - g) / d + 4;
        h *= 60;
        if (h < 0) h += 360;
      }
      return {
        h: Math.round(h),
        s: Math.round(s * 100),
        l: Math.round(l * 100),
      };
    }

    function relativeLuminance(hex) {
      const clean = hex.replace("#", "");
      const channels = [0, 2, 4].map((i) => {
        const c = parseInt(clean.slice(i, i + 2), 16) / 255;
        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
    }

    function inkOn(hex) {
      return relativeLuminance(hex) > 0.42 ? "#07100f" : "#eaf6f1";
    }

    function rgbString(h, s, l) {
      return `rgb(${hslToRgb(h, s, l).join(", ")})`;
    }

    function hslString(h, s, l) {
      return `hsl(${h}, ${s}%, ${l}%)`;
    }

    function currentHex() {
      return hslToHex(state.h, state.s, state.l);
    }

    let wheelFrame = 0;
    function drawWheel() {
      wheelFrame = 0;
      const size = CANVAS_SIZE;
      const center = size / 2;
      const radius = center - 1;
      const image = ctx.createImageData(size, size);
      const data = image.data;
      const l = state.l;
      for (let y = 0; y < size; y += 1) {
        const dy = y - center;
        for (let x = 0; x < size; x += 1) {
          const dx = x - center;
          const distance = Math.hypot(dx, dy);
          if (distance > radius) continue;
          const index = (y * size + x) * 4;
          const angle = (Math.atan2(dy, dx) * 180) / Math.PI;
          const [r, g, b] = hslToRgb(angle, (distance / radius) * 100, l);
          data[index] = r;
          data[index + 1] = g;
          data[index + 2] = b;
          data[index + 3] = distance > radius - 1.5 ? Math.round(((radius - distance) / 1.5) * 255) : 255;
        }
      }
      ctx.putImageData(image, 0, 0);
    }

    function scheduleWheel() {
      if (!wheelFrame) {
        wheelFrame = requestAnimationFrame(drawWheel);
      }
    }

    function schemeColors() {
      if (schemes[state.scheme] === "mono") {
        return [-24, -12, 0, 12, 24].map((offset) => ({
          h: state.h,
          s: state.s,
          l: clamp(state.l + offset, 6, 94),
        }));
      }
      return schemes[state.scheme].map((offset) => ({
        h: (state.h + offset + 360) % 360,
        s: state.s,
        l: state.l,
      }));
    }

    function updateTracks() {
      hue.style.setProperty(
        "--track",
        "linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000)",
      );
      sat.style.setProperty(
        "--track",
        `linear-gradient(to right, ${hslString(state.h, 0, state.l)}, ${hslString(state.h, 100, state.l)})`,
      );
      light.style.setProperty(
        "--track",
        `linear-gradient(to right, ${hslString(state.h, state.s, 4)}, ${hslString(state.h, state.s, 50)} 50%, ${hslString(state.h, state.s, 96)})`,
      );
    }

    const monoMarkerSizes = [32, 25, 19, 13, 8];

    function renderMarkers() {
      const colors = schemeColors();
      const isMono = state.scheme === "monocromatica";
      const baseIndex = isMono ? 2 : schemes[state.scheme].indexOf(0);

      markers.replaceChildren();

      colors.forEach((color, index) => {
        const hex = hslToHex(color.h, color.s, color.l);
        const angle = (color.h * Math.PI) / 180;
        const distance = color.s / 100;
        const marker = document.createElement("span");

        marker.className = "marker";
        marker.style.left = `${50 + Math.cos(angle) * distance * 50}%`;
        marker.style.top = `${50 + Math.sin(angle) * distance * 50}%`;
        marker.style.setProperty("--marker", hex);
        marker.title = index === baseIndex ? `${hex.toUpperCase()} (base)` : hex.toUpperCase();

        if (index === baseIndex) marker.classList.add("is-base");
        if (isMono) {
          marker.classList.add("is-mono");
          marker.style.setProperty("--size", `${monoMarkerSizes[index]}px`);
        }

        markers.appendChild(marker);
      });
    }

    function flashStatus(el, text) {
      el.textContent = text;
      clearTimeout(el._timer);
      el._timer = setTimeout(() => {
        el.textContent = "";
      }, 1600);
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.top = "-100px";
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand("copy");
        } catch {
          ok = false;
        }
        area.remove();
        return ok;
      }
    }

    function renderSwatches() {
      swatches.replaceChildren();
      for (const color of schemeColors()) {
        const hex = hslToHex(color.h, color.s, color.l);
        const card = document.createElement("div");
        card.className = "swatch-card";

        const main = document.createElement("button");
        main.type = "button";
        main.className = "swatch-main";
        main.style.setProperty("--swatch", hex);
        main.title = `usar ${hex.toUpperCase()} como base`;
        main.setAttribute("aria-label", `usar ${hex.toUpperCase()} como base`);
        main.addEventListener("click", () => {
          state.h = color.h;
          state.s = color.s;
          state.l = color.l;
          update(true);
        });

        const foot = document.createElement("div");
        foot.className = "swatch-foot";
        const label = document.createElement("span");
        label.textContent = hex.toUpperCase();
        const add = document.createElement("button");
        add.type = "button";
        add.className = "swatch-add";
        add.textContent = "+";
        add.title = "adicionar à minha paleta";
        add.setAttribute("aria-label", `adicionar ${hex.toUpperCase()} à minha paleta`);
        add.addEventListener("click", () => addToPalette(hex));

        foot.append(label, add);
        card.append(main, foot);
        swatches.appendChild(card);
      }
    }

    function savePalette() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state.palette));
      } catch {
        /* localStorage indisponível */
      }
    }

    function loadPalette() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        if (Array.isArray(parsed)) {
          state.palette = parsed
            .filter((hex) => typeof hex === "string" && /^#[0-9a-f]{6}$/i.test(hex))
            .slice(0, 12);
        }
      } catch {
        state.palette = [];
      }
    }

    function addToPalette(hex) {
      const normalized = hex.toLowerCase();
      if (state.palette.includes(normalized)) {
        flashStatus(paletteStatus, "essa cor já está na paleta");
        return;
      }
      if (state.palette.length >= 12) {
        flashStatus(paletteStatus, "a paleta já tem 12 cores");
        return;
      }
      state.palette.push(normalized);
      savePalette();
      renderPalette();
      renderPreview();
      flashStatus(paletteStatus, `${hex.toUpperCase()} adicionada`);
    }

    function removeFromPalette(hex) {
      state.palette = state.palette.filter((item) => item !== hex);
      savePalette();
      renderPalette();
      renderPreview();
    }

    function renderPalette() {
      paletteList.replaceChildren();
      paletteEmpty.hidden = state.palette.length > 0;
      for (const hex of state.palette) {
        const chip = document.createElement("div");
        chip.className = "chip";

        const swatch = document.createElement("span");
        swatch.className = "chip-color";
        swatch.style.background = hex;

        const copy = document.createElement("button");
        copy.type = "button";
        copy.textContent = hex.toUpperCase();
        copy.title = "copiar hex";
        copy.addEventListener("click", async () => {
          const ok = await copyText(hex.toUpperCase());
          flashStatus(paletteStatus, ok ? `${hex.toUpperCase()} copiada` : "não deu pra copiar");
        });

        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.title = "remover da paleta";
        remove.setAttribute("aria-label", `remover ${hex.toUpperCase()}`);
        remove.addEventListener("click", () => removeFromPalette(hex));

        chip.append(swatch, copy, remove);
        paletteList.appendChild(chip);
      }
    }

    function renderPreview() {
      const usePalette = state.palette.length >= 2;
      const colors = usePalette
        ? state.palette
        : schemeColors().map((c) => hslToHex(c.h, c.s, c.l));
      const background = colors[0];
      const card = colors[1] || colors[0];
      const accent = colors[2] || colors[0];
      const cardInk = inkOn(card);
      const accentInk = inkOn(accent);

      previewSource.textContent = usePalette
        ? "prévia com a minha paleta"
        : "prévia com a harmonia atual";

      previewShell.style.background = background;
      previewCard.style.background = card;
      previewCard.style.color = cardInk;
      previewCard.style.borderColor = cardInk + "55";
      previewBtn.style.background = accent;
      previewBtn.style.color = accentInk;
      previewBtn.style.borderColor = accentInk + "66";
      previewLink.style.color = cardInk;
      previewLink.style.textDecorationColor = cardInk + "aa";
    }

    function update(redraw = false) {
      state.h = (state.h + 360) % 360;
      state.s = clamp(state.s, 0, 100);
      state.l = clamp(state.l, 0, 100);

      const hex = currentHex();
      colorBlock.style.background = hex;
      hexText.textContent = hex.toUpperCase();
      rgbOut.textContent = rgbString(state.h, state.s, state.l);
      hslOut.textContent = hslString(state.h, state.s, state.l);

      hexInput.value = hex.toUpperCase();
      hexInput.classList.remove("invalid");
      hue.value = String(state.h);
      sat.value = String(state.s);
      light.value = String(state.l);
      hueOut.textContent = `${state.h}°`;
      satOut.textContent = `${state.s}%`;
      lightOut.textContent = `${state.l}%`;
      wrap.setAttribute("aria-valuenow", String(state.h));
      wrap.setAttribute("aria-valuetext", `matiz ${state.h} graus, saturação ${state.s}%`);

      updateTracks();
      renderMarkers();
      renderSwatches();
      renderPreview();

      if (redraw) scheduleWheel();
    }

    function pickFromPointer(event) {
      const rect = canvas.getBoundingClientRect();
      const dx = event.clientX - (rect.left + rect.width / 2);
      const dy = event.clientY - (rect.top + rect.height / 2);
      const radius = rect.width / 2;
      const distance = Math.min(1, Math.hypot(dx, dy) / radius);
      state.h = Math.round((Math.atan2(dy, dx) * 180) / Math.PI);
      if (state.h < 0) state.h += 360;
      state.s = Math.round(distance * 100);
      update(false);
    }

    wrap.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      wrap.setPointerCapture(event.pointerId);
      wrap.focus({ preventScroll: true });
      pickFromPointer(event);
    });

    wrap.addEventListener("pointermove", (event) => {
      if (wrap.hasPointerCapture(event.pointerId)) {
        pickFromPointer(event);
      }
    });

    wrap.addEventListener("pointerup", (event) => {
      if (wrap.hasPointerCapture(event.pointerId)) {
        wrap.releasePointerCapture(event.pointerId);
      }
    });

    wrap.addEventListener("pointercancel", () => {
      if (wheelFrame) {
        cancelAnimationFrame(wheelFrame);
        wheelFrame = 0;
      }
    });

    wrap.addEventListener("keydown", (event) => {
      const step = event.shiftKey ? 10 : 2;
      if (event.key === "ArrowLeft") state.h -= step;
      else if (event.key === "ArrowRight") state.h += step;
      else if (event.key === "ArrowUp") state.s += step;
      else if (event.key === "ArrowDown") state.s -= step;
      else return;
      event.preventDefault();
      update(false);
    });

    hue.addEventListener("input", () => {
      state.h = Number(hue.value);
      update(false);
    });

    sat.addEventListener("input", () => {
      state.s = Number(sat.value);
      update(false);
    });

    light.addEventListener("input", () => {
      state.l = Number(light.value);
      update(true);
    });

    hexInput.addEventListener("input", () => {
      const parsed = hexToHsl(hexInput.value);
      hexInput.classList.toggle("invalid", parsed === null && hexInput.value.trim() !== "");
    });

    function applyHex() {
      const parsed = hexToHsl(hexInput.value);
      if (parsed) {
        state.h = parsed.h;
        state.s = parsed.s;
        state.l = parsed.l;
        update(true);
      } else {
        hexInput.value = currentHex().toUpperCase();
        hexInput.classList.remove("invalid");
      }
    }

    hexInput.addEventListener("change", applyHex);
    hexInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        applyHex();
      }
    });

    document.getElementById("randomBtn").addEventListener("click", () => {
      state.h = Math.floor(Math.random() * 360);
      state.s = 42 + Math.floor(Math.random() * 49);
      state.l = 34 + Math.floor(Math.random() * 33);
      update(true);
    });

    schemeBtns.forEach((button) => {
      button.addEventListener("click", () => {
        state.scheme = button.dataset.scheme;
        schemeBtns.forEach((item) => {
          item.setAttribute("aria-pressed", item === button ? "true" : "false");
        });
        renderMarkers();
        renderSwatches();
        renderPreview();
      });
    });

    for (const button of document.querySelectorAll("[data-copy]")) {
      button.addEventListener("click", async () => {
        const type = button.dataset.copy;
        let text = currentHex().toUpperCase();
        if (type === "rgb") text = rgbString(state.h, state.s, state.l);
        if (type === "hsl") text = hslString(state.h, state.s, state.l);
        const ok = await copyText(text);
        flashStatus(copyStatus, ok ? `${type} copiado` : "não deu pra copiar");
      });
    }

    document.getElementById("copyCssBtn").addEventListener("click", async () => {
      if (state.palette.length === 0) {
        flashStatus(paletteStatus, "a paleta está vazia");
        return;
      }
      const css = [
        ":root {",
        ...state.palette.map((hex, i) => `  --palette-${i + 1}: ${hex};`),
        "}",
      ].join("\n");
      const ok = await copyText(css);
      flashStatus(paletteStatus, ok ? "css copiado" : "não deu pra copiar");
    });

    document.getElementById("clearPaletteBtn").addEventListener("click", () => {
      state.palette = [];
      savePalette();
      renderPalette();
      renderPreview();
      flashStatus(paletteStatus, "paleta limpa");
    });

    loadPalette();
    renderPalette();
    update(true);
  </script>
</BlogLayout>
