  <section class="theory">
    <h2>color theory, briefly</h2>

    <details>
      <summary>harmonies</summary>
      <p>
        Harmonies are colors that sit at fixed angles on the wheel. Complementary
        pairs sit 180° apart and give maximum contrast. Split-complementary takes
        the two neighbors of that opposite point — softer, easier to balance.
        Analogous colors are adjacent (here ±25°) and feel calm. Triadic spreads
        three colors 120° apart, tetradic uses 60°/180°/240°, and square uses
        90° steps. When one color dominates, the others read as accents.
      </p>
    </details>

    <details>
      <summary>shades, tints and tones</summary>
      <p>
        Shades add black, tints add white, tones add gray. All three keep the hue
        and lower the drama, which is why they are useful for backgrounds, borders
        and hover states. Pick one saturated accent, then fill the rest of the
        interface with tints, shades and tones of it.
      </p>
    </details>

    <details>
      <summary>primary, secondary and tertiary</summary>
      <p>
        In the traditional painter's wheel, primaries are red, yellow and blue;
        secondaries are the mixes of two primaries (orange, green, purple); and
        tertiaries mix a primary with a neighboring secondary (vermilion, amber,
        chartreuse, teal, violet, magenta). Screens mix light instead of pigment,
        so the wheel above is RGB-based — same relationships, different primaries.
      </p>
    </details>

    <details>
      <summary>using this wheel</summary>
      <p>
        Drag on the disc to set hue and saturation, use the outer ring for
        lightness, then rotate the whole harmony by dragging any handle. Paste a
        hex into the field to start from an existing color, copy any code from the
        table, and export the palette when it feels right.
      </p>
    </details>
  </section>

  <script is:inline>
    const STORAGE_KEY = "thisdev-color-palette";
    const CANVAS_SIZE = 480;
    const DISK = 0.84;
    const MAX_COLORS = 24;
    const SERIES_STEPS = [10, 20, 30, 40, 50, 60, 70, 80, 90];
    const schemes = {
      complementar: [0, 180],
      split: [0, 150, 210],
      analogica: [-25, 0, 25],
      triade: [0, 120, 240],
      tetrade: [0, 60, 180, 240],
      quadrada: [0, 90, 180, 270],
      monocromatica: "mono",
    };
    const schemeLabels = {
      complementar: "complementar",
      split: "split-complementar",
      analogica: "análoga",
      triade: "tríade",
      tetrade: "tétrade",
      quadrada: "quadrada",
      monocromatica: "monocromática",
    };
    const monoSteps = [-32, -24, -16, -8, 0, 8, 16, 24, 32];
    const monoMarkerSizes = [42, 36, 31, 26, 22, 18, 14, 11, 8];
    const seriesDefs = [
      { key: "shades", label: "shades", mix: "#000000" },
      { key: "tints", label: "tints", mix: "#ffffff" },
      { key: "tones", label: "tones", mix: "#808080" },
    ];
    const codeKeys = ["hex", "rgb", "hsl", "hsv", "oklch", "cmyk"];

    const state = {
      h: 172,
      s: 44,
      l: 42,
      scheme: "analogica",
      palette: [],
    };

    const wrap = document.getElementById("wheelWrap");
    const canvas = document.getElementById("wheel");
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    const markers = document.getElementById("markers");
    const ringKnob = document.getElementById("ringKnob");
    const colorBlock = document.getElementById("colorBlock");
    const hexText = document.getElementById("hexText");
    const rgbOut = document.getElementById("rgbOut");
    const hslOut = document.getElementById("hslOut");
    const hexInput = document.getElementById("hexInput");
    const hue = document.getElementById("hue");
    const sat = document.getElementById("sat");
    const light = document.getElementById("light");
    const hueOut = document.getElementById("hueOut");
    const satOut = document.getElementById("satOut");
    const lightOut = document.getElementById("lightOut");
    const copyStatus = document.getElementById("copyStatus");
    const codesStatus = document.getElementById("codesStatus");
    const seriesStatus = document.getElementById("seriesStatus");
    const paletteStatus = document.getElementById("paletteStatus");
    const paletteList = document.getElementById("paletteList");
    const paletteEmpty = document.getElementById("paletteEmpty");
    const previewShell = document.getElementById("previewShell");
    const previewCard = document.getElementById("previewCard");
    const previewBtn = document.getElementById("previewBtn");
    const previewLink = document.getElementById("previewLink");
    const previewSource = document.getElementById("previewSource");
    const schemeBtns = [...document.querySelectorAll("[data-scheme]")];
    const swatches = document.getElementById("swatches");
    const codesBody = document.getElementById("codesBody");
    const seriesList = document.getElementById("seriesList");
    const importArea = document.getElementById("importArea");

    // --- cores: conversões -------------------------------------------------

    function clamp(n, min, max) {
      return Math.min(max, Math.max(min, n));
    }

    function normalizeHue(h) {
      return ((h % 360) + 360) % 360;
    }

    function hslToRgb(h, s, l) {
      h = normalizeHue(h);
      s = clamp(s, 0, 100) / 100;
      l = clamp(l, 0, 100) / 100;
      const c = (1 - Math.abs(2 * l - 1)) * s;
      const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
      const m = l - c / 2;
      let r = 0;
      let g = 0;
      let b = 0;
      if (h < 60) [r, g, b] = [c, x, 0];
      else if (h < 120) [r, g, b] = [x, c, 0];
      else if (h < 180) [r, g, b] = [0, c, x];
      else if (h < 240) [r, g, b] = [0, x, c];
      else if (h < 300) [r, g, b] = [x, 0, c];
      else [r, g, b] = [c, 0, x];
      return [
        Math.round((r + m) * 255),
        Math.round((g + m) * 255),
        Math.round((b + m) * 255),
      ];
    }

    function toHex(n) {
      return n.toString(16).padStart(2, "0");
    }

    function rgbToHex(rgb) {
      return "#" + rgb.map(toHex).join("");
    }

    function hslToHex(h, s, l) {
      return rgbToHex(hslToRgb(h, s, l));
    }

    function hexToRgb(hex) {
      let clean = hex.trim().replace(/^#/, "");
      if (clean.length === 3) {
        clean = clean
          .split("")
          .map((c) => c + c)
          .join("");
      }
      if (!/^[0-9a-f]{6}$/i.test(clean)) return null;
      return [
        parseInt(clean.slice(0, 2), 16),
        parseInt(clean.slice(2, 4), 16),
        parseInt(clean.slice(4, 6), 16),
      ];
    }

    function hexToHsl(hex) {
      const rgb = hexToRgb(hex);
      if (!rgb) return null;
      const [r255, g255, b255] = rgb;
      const r = r255 / 255;
      const g = g255 / 255;
      const b = b255 / 255;
      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      const l = (max + min) / 2;
      let h = 0;
      let s = 0;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        if (max === r) h = ((g - b) / d) % 6;
        else if (max === g) h = (b - r) / d + 2;
        else h = (r - g) / d + 4;
        h *= 60;
        if (h < 0) h += 360;
      }
      return {
        h: Math.round(h),
        s: Math.round(s * 100),
        l: Math.round(l * 100),
      };
    }

    function rgbToHsv(rgb) {
      const r = rgb[0] / 255;
      const g = rgb[1] / 255;
      const b = rgb[2] / 255;
      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      const d = max - min;
      let h = 0;
      if (d !== 0) {
        if (max === r) h = ((g - b) / d) % 6;
        else if (max === g) h = (b - r) / d + 2;
        else h = (r - g) / d + 4;
        h *= 60;
        if (h < 0) h += 360;
      }
      return {
        h: Math.round(h),
        s: Math.round(max === 0 ? 0 : (d / max) * 100),
        v: Math.round(max * 100),
      };
    }

    function srgbToLinear(c) {
      return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
    }

    function rgbToOklch(rgb) {
      const r = srgbToLinear(rgb[0] / 255);
      const g = srgbToLinear(rgb[1] / 255);
      const b = srgbToLinear(rgb[2] / 255);
      const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
      const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
      const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
      const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
      const a = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
      const bb = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
      let h = (Math.atan2(bb, a) * 180) / Math.PI;
      if (h < 0) h += 360;
      return { l: L * 100, c: Math.hypot(a, bb), h };
    }

    function rgbToCmyk(rgb) {
      const r = rgb[0] / 255;
      const g = rgb[1] / 255;
      const b = rgb[2] / 255;
      const k = 1 - Math.max(r, g, b);
      if (k >= 1) return { c: 0, m: 0, y: 0, k: 100 };
      return {
        c: Math.round(((1 - r - k) / (1 - k)) * 100),
        m: Math.round(((1 - g - k) / (1 - k)) * 100),
        y: Math.round(((1 - b - k) / (1 - k)) * 100),
        k: Math.round(k * 100),
      };
    }

    function relativeLuminance(hex) {
      const rgb = hexToRgb(hex);
      if (!rgb) return 0;
      const channels = rgb.map((value) => {
        const c = value / 255;
        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
    }

    function inkOn(hex) {
      return relativeLuminance(hex) > 0.42 ? "#07100f" : "#eaf6f1";
    }

    function mixHex(a, b, t) {
      const A = hexToRgb(a);
      const B = hexToRgb(b);
      if (!A || !B) return a;
      return rgbToHex(A.map((value, index) => Math.round(value + (B[index] - value) * t)));
    }

    function rgbString(h, s, l) {
      return `rgb(${hslToRgb(h, s, l).join(", ")})`;
    }

    function hslString(h, s, l) {
      return `hsl(${h}, ${s}%, ${l}%)`;
    }

    function currentHex() {
      return hslToHex(state.h, state.s, state.l);
    }

    function currentCodes() {
      const hex = currentHex();
      const rgb = hslToRgb(state.h, state.s, state.l);
      const hsv = rgbToHsv(rgb);
      const oklch = rgbToOklch(rgb);
      const cmyk = rgbToCmyk(rgb);
      const oklchCode = `oklch(${oklch.l.toFixed(1)}% ${oklch.c.toFixed(3)} ${oklch.h.toFixed(1)})`;
      return [
        { label: "hex", code: hex.toUpperCase(), css: hex.toUpperCase() },
        { label: "rgb", code: `rgb(${rgb.join(", ")})`, css: `rgb(${rgb.join(" ")})` },
        { label: "hsl", code: hslString(state.h, state.s, state.l), css: `hsl(${state.h} ${state.s}% ${state.l}%)` },
        { label: "hsv", code: `hsv(${hsv.h}, ${hsv.s}%, ${hsv.v}%)`, css: "—" },
        { label: "oklch", code: oklchCode, css: oklchCode },
        { label: "cmyk", code: `cmyk(${cmyk.c}%, ${cmyk.m}%, ${cmyk.y}%, ${cmyk.k}%)`, css: "—" },
      ];
    }

    // --- roda: desenho -----------------------------------------------------

    const frameImage = ctx.createImageData(CANVAS_SIZE, CANVAS_SIZE);
    let diskCache = { l: null, data: null };
    let wheelFrame = 0;

    function buildDisk(lightness) {
      const size = CANVAS_SIZE;
      const center = size / 2;
      const maxRadius = center - 1;
      const diskRadius = maxRadius * DISK;
      const data = new Uint8ClampedArray(size * size * 4);
      for (let y = 0; y < size; y += 1) {
        const dy = y - center;
        for (let x = 0; x < size; x += 1) {
          const dx = x - center;
          const distance = Math.hypot(dx, dy);
          if (distance > diskRadius) continue;
          const index = (y * size + x) * 4;
          const angle = (Math.atan2(dy, dx) * 180) / Math.PI;
          const [r, g, b] = hslToRgb(angle, (distance / diskRadius) * 100, lightness);
          data[index] = r;
          data[index + 1] = g;
          data[index + 2] = b;
          data[index + 3] =
            distance > diskRadius - 1.5
              ? Math.round(((diskRadius - distance) / 1.5) * 255)
              : 255;
        }
      }
      return data;
    }

    function paintRing(data, hueValue, satValue) {
      const size = CANVAS_SIZE;
      const center = size / 2;
      const maxRadius = center - 1;
      const diskRadius = maxRadius * DISK;
      const ringInner = maxRadius - 1.5;
      for (let y = 0; y < size; y += 1) {
        const dy = y - center;
        for (let x = 0; x < size; x += 1) {
          const dx = x - center;
          const distance = Math.hypot(dx, dy);
          if (distance <= diskRadius || distance > maxRadius) continue;
          const index = (y * size + x) * 4;
          let angle = (Math.atan2(dy, dx) * 180) / Math.PI;
          if (angle < 0) angle += 360;
          let fromTop = (angle + 90) % 360;
          if (fromTop > 180) fromTop = 360 - fromTop;
          const lightness = 100 - (fromTop / 180) * 100;
          const [r, g, b] = hslToRgb(hueValue, satValue, lightness);
          data[index] = r;
          data[index + 1] = g;
          data[index + 2] = b;
          data[index + 3] =
            distance > ringInner
              ? Math.round(((maxRadius - distance) / 1.5) * 255)
              : 255;
        }
      }
    }

    function drawWheel() {
      wheelFrame = 0;
      if (!diskCache.data || diskCache.l !== state.l) {
        diskCache = { l: state.l, data: buildDisk(state.l) };
      }
      frameImage.data.set(diskCache.data);
      paintRing(frameImage.data, state.h, state.s);
      ctx.putImageData(frameImage, 0, 0);
    }

    function scheduleWheel() {
      if (!wheelFrame) {
        wheelFrame = requestAnimationFrame(drawWheel);
      }
    }

    // --- harmonia ----------------------------------------------------------

    function schemeColors() {
      if (schemes[state.scheme] === "mono") {
        return monoSteps.map((offset) => ({
          h: state.h,
          s: state.s,
          l: clamp(state.l + offset, 4, 96),
        }));
      }
      return schemes[state.scheme].map((offset) => ({
        h: normalizeHue(state.h + offset),
        s: state.s,
        l: state.l,
      }));
    }

    function updateTracks() {
      hue.style.setProperty(
        "--track",
        "linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000)",
      );
      sat.style.setProperty(
        "--track",
        `linear-gradient(to right, ${hslString(state.h, 0, state.l)}, ${hslString(state.h, 100, state.l)})`,
      );
      light.style.setProperty(
        "--track",
        `linear-gradient(to right, ${hslString(state.h, state.s, 4)}, ${hslString(state.h, state.s, 50)} 50%, ${hslString(state.h, state.s, 96)})`,
      );
    }

    const markerNodes = [];

    function syncMarkers() {
      const colors = schemeColors();
      const isMono = state.scheme === "monocromatica";
      const baseIndex = isMono ? monoSteps.indexOf(0) : schemes[state.scheme].indexOf(0);

      while (markerNodes.length > colors.length) {
        markerNodes.pop().remove();
      }

      colors.forEach((color, index) => {
        let marker = markerNodes[index];
        if (!marker) {
          marker = document.createElement("span");
          marker.className = "marker";
          marker.dataset.index = String(index);
          markers.appendChild(marker);
          markerNodes[index] = marker;
        }

        const hex = hslToHex(color.h, color.s, color.l);
        const angle = (color.h * Math.PI) / 180;
        const radius = (color.s / 100) * DISK * 50;

        marker.style.left = `${50 + Math.cos(angle) * radius}%`;
        marker.style.top = `${50 + Math.sin(angle) * radius}%`;
        marker.style.setProperty("--marker", hex);
        marker.title = index === baseIndex ? `${hex.toUpperCase()} (base)` : hex.toUpperCase();

        marker.classList.toggle("is-base", index === baseIndex);
        marker.classList.toggle("is-mono", isMono);

        if (isMono) {
          marker.style.setProperty("--size", `${monoMarkerSizes[index]}px`);
        } else {
          marker.style.removeProperty("--size");
        }
      });
    }

    function syncRingKnob() {
      const fromTop = ((100 - state.l) / 100) * 180;
      const angle = ((-90 + fromTop) * Math.PI) / 180;
      const radius = ((DISK + 1) / 2) * 50;

      ringKnob.style.left = `${50 + Math.cos(angle) * radius}%`;
      ringKnob.style.top = `${50 + Math.sin(angle) * radius}%`;
      ringKnob.style.setProperty("--knob", currentHex());
      ringKnob.title = `luminosidade ${state.l}%`;
    }

    function renderSwatches() {
      swatches.replaceChildren();
      for (const color of schemeColors()) {
        const hex = hslToHex(color.h, color.s, color.l);
        const card = document.createElement("div");
        card.className = "swatch-card";

        const main = document.createElement("button");
        main.type = "button";
        main.className = "swatch-main";
        main.style.setProperty("--swatch", hex);
        main.title = `usar ${hex.toUpperCase()} como base`;
        main.setAttribute("aria-label", `usar ${hex.toUpperCase()} como base`);
        main.addEventListener("click", () => {
          state.h = color.h;
          state.s = color.s;
          state.l = color.l;
          update();
        });

        const foot = document.createElement("div");
        foot.className = "swatch-foot";
        const label = document.createElement("span");
        label.textContent = hex.toUpperCase();
        const add = document.createElement("button");
        add.type = "button";
        add.className = "swatch-add";
        add.textContent = "+";
        add.title = "adicionar à minha paleta";
        add.setAttribute("aria-label", `adicionar ${hex.toUpperCase()} à minha paleta`);
        add.addEventListener("click", () => addToPalette(hex));

        foot.append(label, add);
        card.append(main, foot);
        swatches.appendChild(card);
      }
    }

    // --- códigos -----------------------------------------------------------

    const codeCells = [];

    function buildCodesTable() {
      for (const key of codeKeys) {
        const row = document.createElement("tr");
        const labelCell = document.createElement("td");
        labelCell.textContent = key;

        const codeCell = document.createElement("td");
        const codeBtn = document.createElement("button");
        codeBtn.type = "button";
        codeBtn.className = "code-cell";
        codeCell.appendChild(codeBtn);

        const cssCell = document.createElement("td");
        const cssBtn = document.createElement("button");
        cssBtn.type = "button";
        cssBtn.className = "code-cell";
        cssCell.appendChild(cssBtn);

        row.append(labelCell, codeCell, cssCell);
        codesBody.appendChild(row);
        codeCells.push({ codeBtn, cssBtn });

        codeBtn.addEventListener("click", async () => {
          if (codeBtn.textContent === "—") return;
          const ok = await copyText(codeBtn.textContent);
          flashStatus(codesStatus, ok ? `${key} copiado` : "não deu pra copiar");
        });

        cssBtn.addEventListener("click", async () => {
          if (cssBtn.textContent === "—") return;
          const ok = await copyText(cssBtn.textContent);
          flashStatus(codesStatus, ok ? `${key} css copiado` : "não deu pra copiar");
        });
      }
    }

    function renderCodes() {
      const rows = currentCodes();
      rows.forEach((row, index) => {
        const cells = codeCells[index];
        if (!cells) return;

        cells.codeBtn.textContent = row.code;
        cells.codeBtn.title = `copiar ${row.label}`;

        cells.cssBtn.textContent = row.css;
        cells.cssBtn.title = row.css === "—" ? `${row.label} não tem sintaxe css` : `copiar ${row.label} css`;
        cells.cssBtn.classList.toggle("code-empty", row.css === "—");
      });
    }

    // --- shades, tints e tones --------------------------------------------

    const seriesRows = [];

    function buildSeries() {
      for (const def of seriesDefs) {
        const row = document.createElement("div");
        row.className = "series-row";

        const label = document.createElement("p");
        label.className = "series-label";
        label.textContent = def.label;

        const strip = document.createElement("div");
        strip.className = "series-strip";

        const buttons = SERIES_STEPS.map(() => {
          const swatch = document.createElement("button");
          swatch.type = "button";
          swatch.className = "series-swatch";
          swatch.dataset.hex = "";
          swatch.addEventListener("click", async () => {
            const hex = swatch.dataset.hex;
            if (!hex) return;
            const ok = await copyText(hex.toUpperCase());
            flashStatus(seriesStatus, ok ? `${hex.toUpperCase()} copiada` : "não deu pra copiar");
          });
          strip.appendChild(swatch);
          return swatch;
        });

        const actions = document.createElement("div");
        actions.className = "series-actions";
        const add = document.createElement("button");
        add.type = "button";
        add.className = "btn tiny";
        add.textContent = "+";
        add.title = `adicionar ${def.label} à paleta`;
        add.setAttribute("aria-label", `adicionar todas as cores de ${def.label} à paleta`);
        add.addEventListener("click", () => {
          addMany(
            buttons.map((button) => button.dataset.hex).filter(Boolean),
            seriesStatus,
          );
        });
        actions.appendChild(add);

        row.append(label, strip, actions);
        seriesList.appendChild(row);
        seriesRows.push({ def, buttons });
      }
    }

    function renderSeries() {
      const base = currentHex();
      for (const { def, buttons } of seriesRows) {
        buttons.forEach((button, index) => {
          const hex = mixHex(base, def.mix, SERIES_STEPS[index] / 100);
          button.dataset.hex = hex;
          button.style.setProperty("--swatch", hex);
          button.title = `${hex.toUpperCase()} · ${def.label} ${SERIES_STEPS[index]}%`;
          button.setAttribute("aria-label", button.title);
        });
      }
    }

    // --- status e cópia ----------------------------------------------------

    function flashStatus(el, text) {
      el.textContent = text;
      clearTimeout(el._timer);
      el._timer = setTimeout(() => {
        el.textContent = "";
      }, 1600);
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.top = "-100px";
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand("copy");
        } catch {
          ok = false;
        }
        area.remove();
        return ok;
      }
    }

    // --- paleta ------------------------------------------------------------

    function savePalette() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state.palette));
      } catch {
        /* localStorage indisponível */
      }
    }

    function loadPalette() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        if (Array.isArray(parsed)) {
          state.palette = parsed
            .filter((hex) => typeof hex === "string" && /^#[0-9a-f]{6}$/i.test(hex))
            .slice(0, MAX_COLORS);
        }
      } catch {
        state.palette = [];
      }
    }

    function addColor(hex) {
      const normalized = hex.toLowerCase();
      if (state.palette.includes(normalized)) return "dup";
      if (state.palette.length >= MAX_COLORS) return "full";
      state.palette.push(normalized);
      return "ok";
    }

    function commitPalette() {
      savePalette();
      renderPalette();
      renderPreview();
    }

    function addToPalette(hex) {
      const result = addColor(hex);
      if (result === "ok") {
        commitPalette();
        flashStatus(paletteStatus, `${hex.toUpperCase()} adicionada`);
      } else if (result === "dup") {
        flashStatus(paletteStatus, "essa cor já está na paleta");
      } else {
        flashStatus(paletteStatus, `a paleta já tem ${MAX_COLORS} cores`);
      }
    }

    function addMany(hexes, statusEl) {
      let added = 0;
      let full = false;
      for (const hex of hexes) {
        const result = addColor(hex);
        if (result === "ok") added += 1;
        else if (result === "full") {
          full = true;
          break;
        }
      }
      if (added > 0) commitPalette();
      const target = statusEl || paletteStatus;
      if (added > 0) flashStatus(target, `${added} cores adicionadas`);
      else if (full) flashStatus(target, `limite de ${MAX_COLORS} cores`);
      else flashStatus(target, "todas já estavam na paleta");
    }

    function removeFromPalette(hex) {
      state.palette = state.palette.filter((item) => item !== hex);
      commitPalette();
    }

    function renderPalette() {
      paletteList.replaceChildren();
      paletteEmpty.hidden = state.palette.length > 0;
      for (const hex of state.palette) {
        const chip = document.createElement("div");
        chip.className = "chip";

        const swatch = document.createElement("span");
        swatch.className = "chip-color";
        swatch.style.background = hex;

        const copy = document.createElement("button");
        copy.type = "button";
        copy.textContent = hex.toUpperCase();
        copy.title = "copiar hex";
        copy.addEventListener("click", async () => {
          const ok = await copyText(hex.toUpperCase());
          flashStatus(paletteStatus, ok ? `${hex.toUpperCase()} copiada` : "não deu pra copiar");
        });

        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.title = "remover da paleta";
        remove.setAttribute("aria-label", `remover ${hex.toUpperCase()}`);
        remove.addEventListener("click", () => removeFromPalette(hex));

        chip.append(swatch, copy, remove);
        paletteList.appendChild(chip);
      }
    }

    function paletteCss() {
      return [
        ":root {",
        ...state.palette.map((hex, index) => `  --palette-${index + 1}: ${hex};`),
        "}",
      ].join("\n");
    }

    function download(name, text, mime) {
      const blob = new Blob([text], { type: mime });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = name;
      link.style.display = "none";
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function exportPalette(format) {
      if (state.palette.length === 0) {
        flashStatus(paletteStatus, "a paleta está vazia");
        return;
      }

      if (format === "css") {
        download("paleta.css", paletteCss() + "\n", "text/css");
      } else if (format === "json") {
        const data = {
          generatedAt: new Date().toISOString(),
          palette: state.palette.map((hex) => {
            const parsed = hexToHsl(hex);
            const rgb = hexToRgb(hex);
            return {
              hex: hex.toUpperCase(),
              rgb: rgb ? `rgb(${rgb.join(", ")})` : "",
              hsl: parsed ? `hsl(${parsed.h}, ${parsed.s}%, ${parsed.l}%)` : "",
            };
          }),
        };
        download("paleta.json", JSON.stringify(data, null, 2) + "\n", "application/json");
      } else {
        download(
          "paleta.txt",
          state.palette.map((hex) => hex.toUpperCase()).join("\n") + "\n",
          "text/plain",
        );
      }

      flashStatus(paletteStatus, `${format} exportado`);
    }

    function parseHexList(text) {
      const matches =
        text.match(/#[0-9a-f]{3}(?:[0-9a-f]{3})?\b|\b[0-9a-f]{6}\b/gi) || [];
      const found = [];
      for (const match of matches) {
        let clean = match.replace("#", "");
        if (clean.length === 3) {
          clean = clean
            .split("")
            .map((char) => char + char)
            .join("");
        }
        const hex = "#" + clean.toLowerCase();
        if (!found.includes(hex)) found.push(hex);
      }
      return found;
    }

    // --- prévia ------------------------------------------------------------

    function renderPreview() {
      const usePalette = state.palette.length >= 2;
      const colors = usePalette
        ? state.palette
        : schemeColors().map((color) => hslToHex(color.h, color.s, color.l));
      const background = colors[0];
      const card = colors[1] || colors[0];
      const accent = colors[2] || colors[0];
      const cardInk = inkOn(card);
      const accentInk = inkOn(accent);

      previewSource.textContent = usePalette
        ? "prévia com a minha paleta"
        : "prévia com a harmonia atual";

      previewShell.style.background = background;
      previewCard.style.background = card;
      previewCard.style.color = cardInk;
      previewCard.style.borderColor = cardInk + "55";
      previewBtn.style.background = accent;
      previewBtn.style.color = accentInk;
      previewBtn.style.borderColor = accentInk + "66";
      previewLink.style.color = cardInk;
      previewLink.style.textDecorationColor = cardInk + "aa";
    }

    // --- estado ------------------------------------------------------------

    function setScheme(name) {
      state.scheme = name;
      schemeBtns.forEach((button) => {
        button.setAttribute("aria-pressed", button.dataset.scheme === name ? "true" : "false");
      });
    }

    function update() {
      state.h = normalizeHue(state.h);
      state.s = clamp(state.s, 0, 100);
      state.l = clamp(state.l, 0, 100);

      const hex = currentHex();
      colorBlock.style.background = hex;
      hexText.textContent = hex.toUpperCase();
      rgbOut.textContent = rgbString(state.h, state.s, state.l);
      hslOut.textContent = hslString(state.h, state.s, state.l);

      hexInput.value = hex.toUpperCase();
      hexInput.classList.remove("invalid");
      hue.value = String(state.h);
      sat.value = String(state.s);
      light.value = String(state.l);
      hueOut.textContent = `${state.h}°`;
      satOut.textContent = `${state.s}%`;
      lightOut.textContent = `${state.l}%`;
      wrap.setAttribute("aria-valuenow", String(state.h));
      wrap.setAttribute(
        "aria-valuetext",
        `matiz ${state.h} graus, saturação ${state.s}%, luminosidade ${state.l}%`,
      );

      updateTracks();
      syncMarkers();
      syncRingKnob();
      renderSwatches();
      renderCodes();
      renderSeries();
      renderPreview();

      scheduleWheel();
    }

    // --- ponteiro ----------------------------------------------------------

    let drag = null;

    function pointerGeometry(event) {
      const rect = canvas.getBoundingClientRect();
      const dx = event.clientX - (rect.left + rect.width / 2);
      const dy = event.clientY - (rect.top + rect.height / 2);
      const radius = rect.width / 2;
      const distance = Math.hypot(dx, dy) / radius;
      let angle = (Math.atan2(dy, dx) * 180) / Math.PI;
      if (angle < 0) angle += 360;
      return { distance, angle, radius };
    }

    function ringLightness(angle) {
      let fromTop = (angle + 90) % 360;
      if (fromTop > 180) fromTop = 360 - fromTop;
      return Math.round(100 - (fromTop / 180) * 100);
    }

    function applyWheel(geometry, snapHue) {
      const hueValue = snapHue
        ? Math.round(geometry.angle / 15) * 15
        : Math.round(geometry.angle);
      state.h = normalizeHue(hueValue);
      state.s = Math.round(clamp(geometry.distance / DISK, 0, 1) * 100);
      update();
    }

    function applyRing(geometry) {
      state.l = clamp(ringLightness(geometry.angle), 0, 100);
      update();
    }

    function shortestAngle(delta) {
      let value = ((delta + 180) % 360 + 360) % 360 - 180;
      return value;
    }

    function applyMarker(geometry) {
      const delta = shortestAngle(geometry.angle - drag.lastAngle);
      drag.lastAngle = geometry.angle;
      drag.hue += delta;
      state.h = drag.hue;
      state.s = Math.round(clamp(geometry.distance / DISK, 0, 1) * 100);
      update();
    }

    wrap.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      const marker = event.target.closest ? event.target.closest(".marker") : null;
      const isKnob = event.target === ringKnob;
      const isMono = marker ? marker.classList.contains("is-mono") : false;
      const geometry = pointerGeometry(event);

      wrap.setPointerCapture(event.pointerId);
      wrap.focus({ preventScroll: true });

      if (marker && !isMono) {
        drag = {
          type: "marker",
          lastAngle: geometry.angle,
          hue: state.h,
        };
        applyMarker(geometry);
        return;
      }

      if (isKnob || geometry.distance > DISK) {
        drag = { type: "ring" };
        applyRing(geometry);
        return;
      }

      drag = { type: "wheel" };
      applyWheel(geometry, event.shiftKey);
    });

    wrap.addEventListener("pointermove", (event) => {
      if (!drag || !wrap.hasPointerCapture(event.pointerId)) return;
      const geometry = pointerGeometry(event);
      if (drag.type === "wheel") applyWheel(geometry, event.shiftKey);
      else if (drag.type === "ring") applyRing(geometry);
      else applyMarker(geometry);
    });

    wrap.addEventListener("pointerup", (event) => {
      if (wrap.hasPointerCapture(event.pointerId)) {
        wrap.releasePointerCapture(event.pointerId);
      }
      drag = null;
    });

    wrap.addEventListener("pointercancel", () => {
      drag = null;
      if (wheelFrame) {
        cancelAnimationFrame(wheelFrame);
        wheelFrame = 0;
      }
    });

    wrap.addEventListener("keydown", (event) => {
      const step = event.shiftKey ? 10 : 2;
      let handled = true;
      if (event.key === "ArrowLeft") state.h -= step;
      else if (event.key === "ArrowRight") state.h += step;
      else if (event.key === "ArrowUp") state.s += step;
      else if (event.key === "ArrowDown") state.s -= step;
      else if (event.key === "PageUp") state.l += step;
      else if (event.key === "PageDown") state.l -= step;
      else if (event.key === "Home") state.l = 100;
      else if (event.key === "End") state.l = 0;
      else handled = false;

      if (!handled) return;
      event.preventDefault();
      update();
    });

    // --- controles ---------------------------------------------------------

    hue.addEventListener("input", () => {
      state.h = Number(hue.value);
      update();
    });

    sat.addEventListener("input", () => {
      state.s = Number(sat.value);
      update();
    });

    light.addEventListener("input", () => {
      state.l = Number(light.value);
      update();
    });

    hexInput.addEventListener("input", () => {
      const parsed = hexToHsl(hexInput.value);
      hexInput.classList.toggle("invalid", parsed === null && hexInput.value.trim() !== "");
    });

    function applyHex() {
      const parsed = hexToHsl(hexInput.value);
      if (parsed) {
        state.h = parsed.h;
        state.s = parsed.s;
        state.l = parsed.l;
        update();
      } else {
        hexInput.value = currentHex().toUpperCase();
        hexInput.classList.remove("invalid");
      }
    }

    hexInput.addEventListener("change", applyHex);
    hexInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        applyHex();
      }
    });

    document.getElementById("randomBtn").addEventListener("click", () => {
      state.h = Math.floor(Math.random() * 360);
      state.s = 42 + Math.floor(Math.random() * 49);
      state.l = 34 + Math.floor(Math.random() * 33);
      update();
    });

    schemeBtns.forEach((button) => {
      button.addEventListener("click", () => {
        setScheme(button.dataset.scheme);
        update();
      });
    });

    for (const button of document.querySelectorAll("[data-copy]")) {
      button.addEventListener("click", async () => {
        const type = button.dataset.copy;
        let text = currentHex().toUpperCase();
        if (type === "rgb") text = rgbString(state.h, state.s, state.l);
        if (type === "hsl") text = hslString(state.h, state.s, state.l);
        const ok = await copyText(text);
        flashStatus(copyStatus, ok ? `${type} copiado` : "não deu pra copiar");
      });
    }

    document.getElementById("copyCodesBtn").addEventListener("click", async () => {
      const text = currentCodes()
        .map((row) => `${row.label}: ${row.code}`)
        .join("\n");
      const ok = await copyText(text);
      flashStatus(codesStatus, ok ? "códigos copiados" : "não deu pra copiar");
    });

    document.getElementById("copyCssBtn").addEventListener("click", async () => {
      if (state.palette.length === 0) {
        flashStatus(paletteStatus, "a paleta está vazia");
        return;
      }
      const ok = await copyText(paletteCss());
      flashStatus(paletteStatus, ok ? "css copiado" : "não deu pra copiar");
    });

    document.getElementById("clearPaletteBtn").addEventListener("click", () => {
      state.palette = [];
      commitPalette();
      flashStatus(paletteStatus, "paleta limpa");
    });

    document.getElementById("randomPaletteBtn").addEventListener("click", () => {
      const keys = Object.keys(schemes);
      const scheme = keys[Math.floor(Math.random() * keys.length)];
      setScheme(scheme);
      state.h = Math.floor(Math.random() * 360);
      state.s = 46 + Math.floor(Math.random() * 44);
      state.l = 36 + Math.floor(Math.random() * 30);
      update();
      flashStatus(paletteStatus, `paleta aleatória: ${schemeLabels[scheme]}`);
    });

    document.getElementById("addHarmonyBtn").addEventListener("click", () => {
      addMany(
        schemeColors().map((color) => hslToHex(color.h, color.s, color.l)),
        paletteStatus,
      );
    });

    document.querySelectorAll("[data-export]").forEach((button) => {
      button.addEventListener("click", () => {
        exportPalette(button.dataset.export);
      });
    });

    document.getElementById("importBtn").addEventListener("click", () => {
      const hexes = parseHexList(importArea.value);
      if (hexes.length === 0) {
        flashStatus(paletteStatus, "nenhum hex válido encontrado");
        return;
      }
      addMany(hexes, paletteStatus);
      importArea.value = "";
    });

    // --- inicialização -----------------------------------------------------

    loadPalette();
    buildCodesTable();
    buildSeries();
    renderPalette();
    update();
  </script>
</BlogLayout>
