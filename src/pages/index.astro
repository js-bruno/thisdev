---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Ever Dream With Dev?">
  <style>
    @keyframes rainbow-run {
      to {
        background-position: 200% center;
      }
    }

    .rainbow-link:hover,
    .rainbow-link:focus-visible {
      background-image: linear-gradient(
        90deg,
        #ff004c,
        #ff8a00,
        #ffe600,
        #2bff88,
        #00d9ff,
        #4d5bff,
        #c400ff,
        #ff004c
      );
      background-size: 200% auto;
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      text-decoration-color: transparent;
      animation: rainbow-run 1.8s linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .rainbow-link:hover,
      .rainbow-link:focus-visible {
        animation: none;
      }
    }
  </style>

  <header>
    <font face="Arial,Helvetica,sans-serif" size="8">
      <strong>EVER DREAM THIS MF?</strong><br />
      <font size="6">every night throughout the world hundreds of people dream about this face</font>
    </font>
  </header>
  <article class="main">
    <nav>
      <ul>
        <li><a href="/projects/">links</a></li>
        <li><a href="/photos/">gallery</a></li>
        <li><a href="http://hotel.thisdev.space/">hotel</a></li>
        <li><a href="/resources/">resources</a></li>
        <li><a href="http://notes.thisdev.space/about/learning-in-public">brain damage</a></li>
        <li><a href="/ai-slops/">ai slops</a></li>
        <li><a href="/color-wheel/" class="rainbow-link">color wheel</a></li>
        <li><a href="/about/">about</a></li>
      </ul>
    </nav>
    <img src="/assets/images/color.png" alt="who knows" />
  </article>
  <footer>
  <td colspan="5">
    <div class="email" style="text-align: center"><br><br><br>
      <font face="Arial,Helvetica,sans-serif" size="2">e-mail: brunocebrsilva@gmail.com</font>
    </div>
  </td>
  </footer>
</BaseLayout>
