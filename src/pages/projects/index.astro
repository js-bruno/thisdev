---
import BlogLayout from "../../layouts/BlogLayout.astro";
import ProjectMap from "../../components/ProjectMap.tsx";
import { projects, links } from "../../data/projects";
---

<BlogLayout
  title="Projects"
  bodyClass="projects-page"
  section="projects"
  code="MAP_02"
  pageTitle="projects"
  pageDescription="três projetos pessoais, três caminhos. arrasta pra organizar, clica num card pra abrir o repositório no GitHub."
  meta={[
    { label: "nós", value: String(projects.length) },
    { label: "links", value: String(links.length) },
  ]}
  wide={true}
>
  <Fragment slot="sidebar">
    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>signal key</span>
        <span aria-hidden="true">⌁</span>
      </div>
      <ul class="sys-index sys-index--plain project-key">
        <li><span><i class="legend-line legend-uses"></i> usa / roda</span></li>
        <li><span><i class="legend-line legend-inspired"></i> inspirou</span></li>
        <li><span><i class="legend-line legend-related"></i> relacionado</span></li>
      </ul>
    </div>

    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>registry // {projects.length}</span>
        <span aria-hidden="true">↗</span>
      </div>
      <ul class="sys-index">
        {
          projects.map((project) => (
            <li>
              <a href={project.href} target="_blank" rel="noopener">
                <span>{project.title}</span>
                <span class="sys-index-count">{project.language}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>sistema</span>
        <span aria-hidden="true">⌁</span>
      </div>
      <dl class="sys-meta">
        <div><dt>nós</dt><dd>{projects.length}</dd></div>
        <div><dt>links</dt><dd>{links.length}</dd></div>
        <div><dt>modo</dt><dd>dark only</dd></div>
      </dl>
    </div>

    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>network</span>
        <span aria-hidden="true">↗</span>
      </div>
      <ul class="sys-index sys-index--plain">
        <li><a href="/">← home</a></li>
        <li><a href="/ai-slops/">ai slops</a></li>
        <li><a href="/tags/">tags</a></li>
      </ul>
    </div>
  </Fragment>

  <ProjectMap client:only="react" projects={projects} links={links} />

  <details class="projects-list">
    <summary>registry completo</summary>
    <ul>
      {
        projects.map((project) => (
          <li>
            <a href={project.href} target="_blank" rel="noopener">
              {project.title}
            </a>
            <span>{project.description}</span>
            <span class="projects-list-meta">
              {project.language} · {project.year}
            </span>
          </li>
        ))
      }
    </ul>
  </details>
</BlogLayout>
