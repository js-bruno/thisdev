---
import BlogLayout from "../../layouts/BlogLayout.astro";
import SystemSidebar from "../../components/system/SystemSidebar.astro";
import SlopBoard from "../../components/SlopBoard.tsx";
import SlopPostContent from "../../components/SlopPostContent.astro";
import { getCollection } from "astro:content";
import type { SlopPostInput } from "../../lib/slops";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const pinned: SlopPostInput[] = posts.map((post) => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString(),
}));

const latest = posts[0];
---

<BlogLayout
  title="ai slops"
  description="lousa local de slop gerado por i.a. — post-its, filtros, importação, exportação e leitura no navegador."
  bodyClass="ai-slops-page"
  section="ai-slops"
  code="SLO_01"
  pageTitle="ai slops"
  pageDescription=""
  meta={[
    { label: "textos", value: String(posts.length) },
    { label: "modo", value: "local only" },
  ]}
  ticker={[
    { label: "lousa local // nada sai do navegador", tone: "green" },
    { label: `${posts.length} textos no arquivo`, tone: "gold" },
    { label: "sem trackers", tone: "muted" },
    { label: "build 2026.11", tone: "blue" },
  ]}
  wide={true}
>
  <Fragment slot="intro">
    <div class="slop-intro-wrap">
      <p class="slop-intro">
        a lousa de slop gerado por i.a. prega o teu post-it, arrasta os outros
        pelo cabeçalho, apaga o que não presta.
        <span class="rainbow-word">nada sai do teu navegador</span> — o teu
        mural vive só ali. os textos longos do site continuam pregados como
        notas fixas.
      </p>
    </div>
  </Fragment>

  <SystemSidebar
    slot="sidebar"
    indexTitle="textos do site"
    items={posts.map((post) => ({
      label: post.data.title,
      href: `/ai-slops/${post.slug}/`,
    }))}
    meta={[
      { label: "notas locais", value: "no navegador" },
      { label: "textos", value: String(posts.length) },
      { label: "ticker", value: "instável" },
      ...(latest
        ? [{ label: "último", value: latest.data.title.slice(0, 22) }]
        : []),
    ]}
    note="a lousa lê e grava só no localStorage. limpar o cache apaga os teus post-its."
  />

  <SlopBoard client:only="react" posts={pinned} />

  {posts.map((post) => <SlopPostContent post={post} />)}
</BlogLayout>

<style>
  @keyframes rainbow-run {
    to { background-position: 200% center; }
  }

  .slop-intro-wrap {
    max-width: 58ch;
    margin: 0 auto;
  }

  .slop-intro {
    margin: 1.15rem auto 0;
    color: var(--sys-muted);
    font-size: 0.88rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .rainbow-word {
    background-image: linear-gradient(
      90deg,
      #ff8f7a,
      #ffe19a,
      #7dff9e,
      #79e6e0,
      #6aa8ff,
      #b39dff,
      #ff8f7a
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: rainbow-run 6s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .rainbow-word { animation: none; }
  }
</style>
