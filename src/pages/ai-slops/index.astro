---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<BlogLayout title="ai slops">
  <style>
    @keyframes rainbow-run {
      to {
        background-position: 200% center;
      }
    }

    .rainbow-word {
      background-image: linear-gradient(
        90deg,
        #ff6b3d,
        #e8c87a,
        #9ed36a,
        #55d6c2,
        #8f9cff,
        #d98fd1,
        #ff6b3d
      );
      background-size: 200% auto;
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      animation: rainbow-run 6s linear infinite;
    }

    :global([data-theme="light"]) .rainbow-word {
      background-image: linear-gradient(
        90deg,
        #b4482a,
        #8a6a1f,
        #4f7a3a,
        #1f7a74,
        #4f5bbf,
        #8a3f80,
        #b4482a
      );
    }

    @media (prefers-reduced-motion: reduce) {
      .rainbow-word {
        animation: none;
      }
    }

    .postlist-footer {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.35rem 1.5rem;
    }
  </style>

  <h1>ai slops</h1>
  <p>
    Guias gerados por i.a <span class="rainbow-word">uteis</span> para min
  </p>

  {
    posts.length === 0 ? (
      <p class="empty">nada por aqui ainda.</p>
    ) : (
      <ol class="postlist postlist--index">
        {posts.map((post) => {
          const date = new Date(post.data.date);
          const htmlDate = date.toISOString().split("T")[0];
          const readable = date.toLocaleDateString("pt-BR", {
            day: "2-digit",
            month: "long",
            year: "numeric",
            timeZone: "UTC",
          });

          return (
            <li class="postlist-item">
              <time class="postlist-date" datetime={htmlDate}>
                {readable}
              </time>
              <a href={`/ai-slops/${post.slug}/`} class="postlist-link">
                {post.data.title}
              </a>
            </li>
          );
        })}
      </ol>
    )
  }

  <p class="postlist-footer">
    <a href="/ai-slops/archive/">arquivo completo →</a>
    <a href="/">← voltar</a>
  </p>
</BlogLayout>
