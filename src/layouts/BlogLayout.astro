---
import site from "../data/site.ts";
import ThemeToggle from "../components/ThemeToggle.tsx";
import KonamiLang from "../components/KonamiLang.tsx";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  background?: boolean;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const pageDesc = description || site.description;
---

<!doctype html>
<html lang="pt-br" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="stylesheet" href="/assets/css/prism-diff.css" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme") || "dark";
        var l = localStorage.getItem("lang") || "pt-br";
        document.documentElement.setAttribute("data-theme", t);
        document.documentElement.lang = l;
      })();
    </script>
  </head>
  <body>
    <a href="#main" id="skip-link" class="visually-hidden">
      <span>Skip to main content</span>
    </a>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <span><a href="/">{site.name}</a></span>
      <ThemeToggle client:load />
      <span>{site.author} — {new Date().getFullYear()}</span>
    </footer>

    <KonamiLang client:load />
  </body>
</html>
