---
import BlogLayout from "./BlogLayout.astro";

interface Props {
  title: string;
  date?: Date;
  description?: string;
  tags?: string | string[];
  mood?: string;
  image?: string;
}

const { title, date, description, tags, mood, image } = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : null;

const htmlDate = date ? new Date(date).toISOString().split("T")[0] : null;

const tagList = tags
  ? Array.isArray(tags)
    ? tags
    : [tags]
  : [];
---

<BlogLayout title={title} description={description}>
  <style>
    pre[class*="language-"] {
      padding: 1rem;
      margin: 1.25rem 0;
      overflow: auto;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    code[class*="language-"],
    pre[class*="language-"] {
      font-family: var(--mono);
      text-align: left;
      white-space: pre;
      word-spacing: normal;
      word-break: normal;
      line-height: 1.5;
      tab-size: 2;
      hyphens: none;
    }
    :not(pre) > code[class*="language-"] {
      background: var(--surface);
      padding: 0.1em;
      border: 1px solid var(--border);
      white-space: normal;
    }
    .token.comment,
    .token.prolog,
    .token.doctype,
    .token.cdata { color: var(--muted); }
    .token.punctuation { color: var(--ink); }
    .token.property,
    .token.tag,
    .token.constant,
    .token.symbol,
    .token.deleted { color: #c9755f; }
    .token.boolean,
    .token.number { color: #c9a227; }
    .token.selector,
    .token.attr-name,
    .token.string,
    .token.char,
    .token.builtin,
    .token.inserted { color: #8f9a5c; }
    .token.operator,
    .token.entity,
    .token.url,
    .language-css .token.string,
    .style .token.string,
    .token.variable { color: var(--ink); }
    .token.atrule,
    .token.attr-value,
    .token.function,
    .token.class-name { color: #e8c87a; }
    .token.keyword { color: #b4482a; }
    .token.regex,
    .token.important { color: #d19a66; }
    .token.important,
    .token.bold { font-weight: bold; }
    .token.italic { font-style: italic; }

    .post-back { margin: 2.5rem 0 0; }

    .back-bracket {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.15rem 0.2rem;
      font-family: var(--display);
      font-size: 0.7em;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--muted);
      transition: color 0.18s ease;
    }

    .back-bracket::before,
    .back-bracket::after {
      content: "";
      width: 0.42rem;
      height: 1.15em;
      border: 1px solid var(--border-strong);
      transition: border-color 0.18s ease, transform 0.18s ease;
    }
    .back-bracket::before { border-right: 0; }
    .back-bracket::after { border-left: 0; }

    .back-bracket:hover,
    .back-bracket:focus-visible { color: var(--accent-2); }
    .back-bracket:hover::before,
    .back-bracket:focus-visible::before {
      border-color: var(--accent-2);
      transform: translateX(-2px);
    }
    .back-bracket:hover::after,
    .back-bracket:focus-visible::after {
      border-color: var(--accent-2);
      transform: translateX(2px);
    }

    @media (prefers-reduced-motion: reduce) {
      .back-bracket,
      .back-bracket::before,
      .back-bracket::after { transition: none; transform: none; }
    }
  </style>

  <article class="post">
    <h1>{title}</h1>

    <ul class="post-meta-list">
      {
        formattedDate && htmlDate && (
          <li>
            <time datetime={htmlDate}>{formattedDate}</time>
          </li>
        )
      }
      {mood && <li class="post-mood">~ {mood}</li>}
      {
        tagList.map((tag) => (
          <li>
            <a
              href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
              class="post-tag"
            >
              #{tag}
            </a>
          </li>
        ))
      }
    </ul>

    {image && <img class="post-hero" src={image} alt="" loading="lazy" />}

    <slot />
  </article>

  <p class="post-back">
    <a class="back-bracket" href="/ai-slops/">← voltar</a>
  </p>
</BlogLayout>
