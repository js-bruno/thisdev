---
import BlogLayout from "./BlogLayout.astro";
import SystemPageHeader from "../components/system/SystemPageHeader.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  date?: Date;
  description?: string;
  tags?: string | string[];
  mood?: string;
  image?: string;
  headings?: Heading[];
  readingTime?: number;
}

const {
  title,
  date,
  description,
  tags,
  mood,
  image,
  headings = [],
  readingTime,
} = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : null;

const tagList = tags ? (Array.isArray(tags) ? tags : [tags]) : [];
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const path = Astro.url.pathname.replace(/\/+$/, "");
---

<BlogLayout
  title={title}
  description={description}
  section="ai-slops"
  showHeader={false}
  meta={[
    ...(formattedDate ? [{ label: "data", value: formattedDate }] : []),
    ...(readingTime ? [{ label: "leitura", value: `${readingTime} min` }] : []),
  ]}
>
  <Fragment slot="sidebar">
    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>transmission info</span>
        <span aria-hidden="true">⌁</span>
      </div>
      <dl class="sys-meta">
        {formattedDate && (
          <div><dt>data</dt><dd>{formattedDate}</dd></div>
        )}
        {mood && <div><dt>mood</dt><dd>~ {mood}</dd></div>}
        <div><dt>leitura</dt><dd>{readingTime ?? 1} min</dd></div>
        <div><dt>tags</dt><dd>{tagList.length}</dd></div>
        <div><dt>modo</dt><dd>dark only</dd></div>
      </dl>
    </div>

    {toc.length > 0 && (
      <div class="sys-panel">
        <div class="sys-panel-head">
          <span>índice</span>
          <span aria-hidden="true">↧</span>
        </div>
        <ul class="post-toc">
          {toc.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>network</span>
        <span aria-hidden="true">↗</span>
      </div>
      <ul class="sys-index sys-index--plain">
        <li><a href="/ai-slops/">← lousa</a></li>
        <li><a href="/tags/">tags</a></li>
        <li><a href="/">home</a></li>
      </ul>
    </div>
  </Fragment>

  <div class="post-progress" aria-hidden="true"></div>

  <article class="post">
    <SystemPageHeader
      title={title}
      description={description}
      path={`~/this_dev${path}`}
      code="LOG"
      meta={[
        ...(formattedDate ? [{ label: "data", value: formattedDate }] : []),
        ...(mood ? [{ label: "mood", value: `~ ${mood}` }] : []),
        { label: "leitura", value: `${readingTime ?? 1} min` },
      ]}
    >
      <ul class="post-meta-list">
        {
          tagList.map((tag) => (
            <li>
              <a
                href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
                class="post-tag"
              >
                #{tag}
              </a>
            </li>
          ))
        }
      </ul>
    </SystemPageHeader>

    {image && (
      <img class="post-hero" src={image} alt="" loading="lazy" />
    )}

    <div class="post-body">
      <slot />
    </div>
  </article>

  <p class="post-back">
    <a class="back-bracket" href="/ai-slops/">← return to board</a>
  </p>
</BlogLayout>

<script>
  const progress = document.querySelector<HTMLElement>(".post-progress");

  if (progress) {
    let ticking = false;

    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      progress.style.transform = `scaleX(${value})`;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );

    update();
  }
</script>
