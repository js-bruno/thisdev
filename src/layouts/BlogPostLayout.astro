---
import BlogLayout from "./BlogLayout.astro";

interface Props {
  title: string;
  date?: Date;
  description?: string;
  tags?: string | string[];
  mood?: string;
  image?: string;
  prevPost?: { url: string; title: string } | null;
  nextPost?: { url: string; title: string } | null;
}

const { title, date, description, tags, mood, image, prevPost, nextPost } =
  Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : null;

const htmlDate = date ? new Date(date).toISOString().split("T")[0] : null;

const tagList = tags
  ? Array.isArray(tags)
    ? tags
    : [tags]
  : [];
---

<BlogLayout title={title} description={description}>
  <style>
    pre[class*="language-"] {
      padding: 1rem;
      margin: 1.25rem 0;
      overflow: auto;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    code[class*="language-"],
    pre[class*="language-"] {
      font-family: var(--mono);
      text-align: left;
      white-space: pre;
      word-spacing: normal;
      word-break: normal;
      line-height: 1.5;
      tab-size: 2;
      hyphens: none;
    }
    :not(pre) > code[class*="language-"] {
      background: var(--surface);
      padding: 0.1em;
      border: 1px solid var(--border);
      white-space: normal;
    }
    .token.comment,
    .token.prolog,
    .token.doctype,
    .token.cdata { color: var(--muted); }
    .token.punctuation { color: var(--ink); }
    .token.property,
    .token.tag,
    .token.constant,
    .token.symbol,
    .token.deleted { color: #e06c75; }
    .token.boolean,
    .token.number { color: #c678dd; }
    .token.selector,
    .token.attr-name,
    .token.string,
    .token.char,
    .token.builtin,
    .token.inserted { color: #98c379; }
    .token.operator,
    .token.entity,
    .token.url,
    .language-css .token.string,
    .style .token.string,
    .token.variable { color: var(--ink); }
    .token.atrule,
    .token.attr-value,
    .token.function,
    .token.class-name { color: #e5c07b; }
    .token.keyword { color: #61afef; }
    .token.regex,
    .token.important { color: #d19a66; }
    .token.important,
    .token.bold { font-weight: bold; }
    .token.italic { font-style: italic; }
  </style>

  <article class="post">
    <h1>{title}</h1>

    <ul class="post-meta-list">
      {
        formattedDate && htmlDate && (
          <li>
            <time datetime={htmlDate}>{formattedDate}</time>
          </li>
        )
      }
      {mood && <li class="post-mood">~ {mood}</li>}
      {
        tagList.map((tag) => (
          <li>
            <a
              href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
              class="post-tag"
            >
              #{tag}
            </a>
          </li>
        ))
      }
    </ul>

    {image && <img class="post-hero" src={image} alt="" loading="lazy" />}

    <slot />
  </article>

  {
    (prevPost || nextPost) && (
      <ul class="links-nextprev">
        {prevPost && (
          <li class="links-nextprev-prev">
            <span>← anterior</span>
            <br />
            <a href={prevPost.url}>{prevPost.title}</a>
          </li>
        )}
        {nextPost && (
          <li class="links-nextprev-next">
            <span>próximo →</span>
            <br />
            <a href={nextPost.url}>{nextPost.title}</a>
          </li>
        )}
      </ul>
    )
  }
</BlogLayout>
