---
interface Props {
  to: string;
}

const { to } = Astro.props;
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>Redirecionando…</title>
  </head>
  <body>
    <p><a href={to}>Ir para {to}</a></p>
  </body>
</html>
