---
import { tickerItems, type TickerItem } from "../../data/ticker";

interface Props {
  items?: TickerItem[];
}

const { items = tickerItems } = Astro.props;
const track = Array.from({ length: 5 }, () => items).flat();
const spoken = items.map((item) => item.label).join(". ");
---

<header class="sys-header">
  <div class="sys-topline">
    <a class="sys-online" href="/" aria-label="voltar para o index" title="voltar para o index">
      <i class="sys-led" aria-hidden="true"></i>
      index
    </a>

    <div class="sys-ticker">
      <div class="sys-ticker-track" aria-hidden="true">
        {
          track.map((item) => (
            <span class={`sys-ticker-item is-${item.tone ?? "muted"}`}>
              {item.label}
            </span>
          ))
        }
      </div>
      <span class="visually-hidden">informações do sistema: {spoken}</span>
    </div>

    <span class="sys-topline-right">pt-br · v.2026</span>
  </div>
</header>
