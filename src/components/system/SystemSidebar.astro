---
interface IndexItem {
  label: string;
  href: string;
  count?: string | number;
  current?: boolean;
}

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  indexTitle?: string;
  items?: IndexItem[];
  meta?: MetaItem[];
  note?: string;
  showNetwork?: boolean;
  indexClass?: string;
}

const {
  indexTitle = "index",
  items = [],
  meta = [],
  note,
  showNetwork = true,
  indexClass = "",
} = Astro.props;
---

{
  items.length > 0 && (
    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>{indexTitle}</span>
        <span aria-hidden="true">↧</span>
      </div>
      <ul class={indexClass ? `sys-index ${indexClass}` : "sys-index"}>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? "true" : undefined}>
              <span>{item.label}</span>
              {item.count !== undefined && (
                <span class="sys-index-count">{item.count}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  meta.length > 0 && (
    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>sistema</span>
        <span aria-hidden="true">⌁</span>
      </div>
      <dl class="sys-meta">
        {meta.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

{note && <p class="sys-aside-note">{note}</p>}

{
  showNetwork && (
    <div class="sys-panel">
      <div class="sys-panel-head">
        <span>network</span>
        <span aria-hidden="true">↗</span>
      </div>
      <ul class="sys-index sys-index--plain">
        <li>
          <a href="/">
            <span>← home</span>
          </a>
        </li>
        <li>
          <a href="/tags/">
            <span>tags</span>
          </a>
        </li>
        <li>
          <a href="/color-wheel/">
            <span>color wheel</span>
          </a>
        </li>
      </ul>
    </div>
  )
}
