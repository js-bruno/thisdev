---
interface Props {
  date: Date;
  mood?: string;
  tags?: string | string[];
  image?: string;
}

const { date, mood, tags, image } = Astro.props;

const tagList = tags ? (Array.isArray(tags) ? tags : [tags]) : [];
const htmlDate = new Date(date).toISOString().split("T")[0];
const readable = new Date(date).toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<li class="micro-entry rope">
  <div class="micro-meta">
    <time datetime={htmlDate}>{readable}</time>
    {mood && <span class="micro-mood">~ {mood}</span>}
  </div>

  <div class="micro-body">
    <slot />
    {image && <img src={image} alt="" loading="lazy" decoding="async" />}
  </div>

  {
    tagList.length > 0 && (
      <div class="micro-tags">
        {tagList.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )
  }
</li>
