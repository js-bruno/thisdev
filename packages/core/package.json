{
  "name": "@thisdev/ui",
  "version": "0.0.0",
  "description": "Ametrine-inspired acrylic CSS design system (tokens + component styles).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.css",
    "./styles.css": "./src/index.css",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "esbuild src/index.css --bundle --minify --outfile=dist/index.css",
    "watch": "esbuild src/index.css --bundle --outfile=dist/index.css --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
